#!/bin/zsh
# cbar: crossbar, a team of Claude Code agents in Rex or tmux (supervisor,
# operators, switchboards). Projects are registered in
# ~/.crossbar/projects/NAME/project.toml; each has a Rex or tmux session of the
# same name with the operator in its first tab.
emulate -L zsh

CROSSBAR=${CROSSBAR_HOME:-~/.crossbar}
BIN=${0:A:h}
ME=${BIN/#$HOME/~}/cbar   # what a new pane types to run this cbar
REPO=${CROSSBAR_REPO:-https://github.com/montanaflynn/crossbar}

usage() {
  print "usage: cbar COMMAND

  new NAME [DIR] [--tmux|--rex]  register a project and create its session with an
                               operator and a local switchboard (DIR: the z match;
                               terminal: the one you're in, else Rex if it's running)
  operator                     run the operator Claude in this pane
  board [--here|--session N]   run the switchboard (--once prints once and exits)
  ls                           registered projects, their sessions and operators
  open NAME                    switch to that project's session
  rm [-y] NAME                 kill its session and unregister it (asks first)
  agent ...                    start and watch agents in this session (cbar agent help)
  watch                        print a line as each of your reports turns done, blocked or
                               error, stops or closes (in central, also project operators)
  update                       install the latest crossbar from GitHub
  version                      the installed version
  help                         this text"
}

agent_usage() {
  print "usage: cbar agent COMMAND    (acts on this pane's session)

  new TASK [--no-worktree]     start Claude in a new tab TASK on the brief
                               ~/.crossbar/projects/<project>/briefs/TASK.md
  ls                           this session's agents and their status
  status TASK                  one agent's status
  tail TASK [N]                the last N lines of its screen (default 60)
  send TASK TEXT               type TEXT and Enter, only if it is idle or done
  wait TASK [SECONDS]          wait until it stops working (default 600)
  close [-f] TASK              close its tab, and remove its worktree if clean and merged;
                               refuses while it works, is blocked or has uncommitted changes"
}

die() { print -u2 "cbar: $*"; exit 1 }

# toml_get FILE KEY: the value of a top-level KEY (strings unquoted)
toml_get() {
  local line
  line=$(grep -m1 "^$2 *= *" $1 2>/dev/null) || return 1
  line=${line#*=}; line=${line## }
  if [[ $line == \"*\" ]]; then
    line=${line#\"}; line=${line%\"}
    line=${line//\\\"/\"}; line=${line//\\\\/\\}
  fi
  print -r -- $line
}

toml_str() { local s=${1//\\/\\\\}; print -r -- "\"${s//\"/\\\"}\"" }

# register NAME DIR TERMINAL: write projects/NAME/project.toml (keeping its
# created time if it exists) and make briefs/ and reports/
register() {
  local name=$1 dir=${2:A} home=$CROSSBAR/projects/$1 created
  mkdir -p $home/briefs $home/reports || return 1
  created=$(toml_get $home/project.toml created) || created=$(date +%Y-%m-%dT%H:%M:%S%z | sed 's/\(..\)$/:\1/')
  print -r -- "name = $(toml_str $name)
path = $(toml_str $dir)
terminal = $(toml_str $3)
created = $created" >$home/project.toml
}

# tmux, on $CROSSBAR_TMUX_SOCKET's server if set (tmux -L)
tm() { tmux ${CROSSBAR_TMUX_SOCKET:+-L} $CROSSBAR_TMUX_SOCKET "$@" }

# the terminal this pane runs in: tmux, rex or nothing
here_terminal() {
  if [[ -n $TMUX_PANE ]]; then print tmux
  elif [[ -n $REX_SESSION ]]; then print rex
  fi
}

# this pane's session name
here_session() {
  case $(here_terminal) in
    tmux) tm display-message -p -t $TMUX_PANE '#{session_name}' ;;
    rex) rex ls --json | jq -r --arg id "$REX_SESSION" '.sessions[] | select(.session_id == $id) | .label' ;;
  esac
}

rex_session_id() {
  rex ls --json 2>/dev/null | jq -r --arg n "$1" '[.sessions[] | select(.label == $n or .session_id == $n)][0].session_id // empty'
}

tmux_has() { tm has-session -t "=$1" 2>/dev/null }

# claude-relay reports Claude's status in tmux as Rex does (elsewhere it just
# runs claude); without it, plain claude
claude_cmd() { [[ -x $BIN/claude-relay ]] && print -r -- $BIN/claude-relay || print claude }

# panes [--here|--session N]: one JSON object per pane, from the switchboard,
# with mux (rex or tmux) and group (the session, or scoped, the tab)
panes() {
  $BIN/switchboard --json "$@" |
    jq -c '.[] | .group as $g | .panes[] | . + {mux: ($g.mux // "rex"), group: $g.label}'
}

# the Rex app to drive: prefer an app attached to our own session (as switchboard does)
app_client() {
  rex client ls --json | jq -r --arg me "${REX_SESSION:-}" '
    [.clients[] | select(.info.kind == "app" and (.connection_state // "connected") == "connected")]
    | sort_by((.session_ids // []) | index($me) == null) | .[0].client_id // empty'
}

cmd_new() {
  local name dir term
  local -a pos
  while (( $# )); do
    case $1 in
      --tmux) term=tmux ;;
      --rex) term=rex ;;
      -*) die "unknown option '$1'" ;;
      *) pos+=($1) ;;
    esac
    shift
  done
  name=$pos[1] dir=$pos[2]
  [[ -z $name ]] && die "usage: cbar new NAME [DIR] [--tmux|--rex]"
  [[ $name == */* ]] && die "project name can't contain '/'"
  [[ -z $term ]] && term=$(here_terminal)
  if [[ -z $term ]]; then
    rex ls --json >/dev/null 2>&1 && term=rex || term=tmux
  fi
  if [[ -z $dir ]]; then
    source ~/.zshrc >/dev/null 2>&1
    dir=$(z -e "$name" 2>/dev/null)
  fi
  [[ -d $dir ]] || die "no directory for '$name' (pass one)"
  register $name $dir $term || die "could not register '$name'"
  new_$term $name $dir
}

new_rex() {
  local name=$1 dir=$2 block board
  if [[ -n $(rex_session_id $name) ]]; then
    print "session '$name' already exists; registered it ($dir)"
    return 0
  fi

  block=$(rex new "$name" -c "$dir" --window operator --json | jq -r '.initial_windows[0].block_ids[0]')
  [[ -n $block && $block != null ]] || die "could not create session '$name'"
  sleep 0.5
  rex send -s "$name" -b "$block" "$ME operator"$'\n'

  # a scoped switchboard (this session's tabs and agents) to the right of the operator
  board=$(rex split -s "$name" -b "$block" -c "$dir" --split=right --ratio 30 --focus=false \
    --label switchboard --json | jq -r '.block_ids[0] // empty')
  [[ -z $board ]] && board=$(rex block ls -s "$name" --json |
    jq -r '[.blocks[] | select(.label == "switchboard")][0].block_id // empty')
  if [[ -n $board ]]; then
    sleep 0.5
    rex send -s "$name" -b "$board" "$ME board --here"$'\n'
  else
    print -u2 "cbar: could not add the switchboard pane"
  fi
  print "created session '$name' in $dir with an operator and a switchboard"
}

new_tmux() {
  local name=$1 dir=$2 pane board
  if tmux_has $name; then
    print "session '$name' already exists; registered it ($dir)"
    return 0
  fi

  pane=$(tm new-session -d -s $name -c $dir -n operator -x 200 -y 50 -P -F '#{pane_id}') ||
    die "could not create session '$name'"
  tm send-keys -t $pane "$ME operator" Enter

  # a scoped switchboard (this session's tabs and agents) to the right of the operator
  board=$(tm split-window -h -d -l 30% -t $pane -c $dir -P -F '#{pane_id}')
  if [[ -n $board ]]; then
    tm set-option -p -t $board @cbar_label switchboard
    tm send-keys -t $board "$ME board --here" Enter
  else
    print -u2 "cbar: could not add the switchboard pane"
  fi
  print "created session '$name' in $dir with an operator and a switchboard (tmux)"
  if [[ -n $TMUX ]]; then print "switch to it: cbar open $name"; else print "attach: cbar open $name"; fi
}

cmd_operator() {
  local project home
  project=$(here_session 2>/dev/null)
  project=${project:-${PWD:t}}
  home=$CROSSBAR/projects/$project
  mkdir -p $home/briefs $home/reports
  exec $(claude_cmd) -n "$project operator" --append-system-prompt "$(<$CROSSBAR/operator.md)

Your project is \`$project\`: briefs go in \`${home/#$HOME/~}/briefs/\`, reports in \`${home/#$HOME/~}/reports/\`."
}

# cbar watch: one line per report event, for the Monitor tool (see switchboard --watch)
cmd_watch() {
  in_session
  [[ -x $BIN/switchboard ]] && exec $BIN/switchboard --watch --here
  exec switchboard --watch --here
}

cmd_board() {
  # the switchboard next to cbar, else the one on PATH
  [[ -x $BIN/switchboard ]] && exec $BIN/switchboard "$@"
  exec switchboard "$@"
}

cmd_ls() {
  local f name dir term all running st
  all=$(panes 2>/dev/null)
  local -a rows=("NAME	TERMINAL	PATH	SESSION	OPERATOR")
  for f in $CROSSBAR/projects/*/project.toml(N); do
    name=$(toml_get $f name) dir=$(toml_get $f path)
    term=$(toml_get $f terminal) || term=rex
    running=$(jq -r --arg n "$name" --arg t "$term" 'select(.group == $n and .mux == $t) | .block_id' <<<$all | head -1)
    st=-
    if [[ -n $running ]]; then
      st=$(jq -r --arg n "$name" --arg t "$term" \
        'select(.group == $n and .mux == $t and .tab == "operator" and .label != "switchboard") | .state' <<<$all | head -1)
      [[ -z $(jq -r --arg n "$name" --arg t "$term" 'select(.group == $n and .mux == $t and .tab == "operator") | 1' <<<$all) ]] &&
        st="no operator tab"
      st=${st:--}
    fi
    rows+=("$name	$term	${dir/#$HOME/~}	${${running:+running}:-not running}	$st")
  done
  (( $#rows > 1 )) || { print "no projects registered (cbar new NAME [DIR])"; return }
  print -l -- $rows | column -t -s $'\t'
}

# cbar rm [-y] NAME: kill the project's session and unregister it, its briefs
# and reports with it. Says what that means and asks first, unless -y.
cmd_rm() {
  local yes= name home term sid running= agents
  [[ $1 == -y || $1 == --yes ]] && { yes=1; shift }
  name=$1
  [[ -z $name ]] && die "usage: cbar rm [-y] NAME"
  [[ $name == */* || $name == . || $name == .. ]] && die "no project '$name'"
  home=$CROSSBAR/projects/$name
  if [[ -f $home/project.toml ]]; then
    term=$(toml_get $home/project.toml terminal) || term=rex
  elif tmux_has $name; then
    term=tmux   # not registered: the session can still go
  elif [[ -n $(rex_session_id $name) ]]; then
    term=rex
  else
    die "no project or session '$name' (cbar ls)"
  fi
  if [[ $term == tmux ]]; then
    tmux_has $name && running=1
  else
    sid=$(rex_session_id $name)
    [[ -n $sid ]] && running=1
  fi

  local -a what
  if [[ -n $running ]]; then
    agents=$(panes --session $name 2>/dev/null | jq -r 'select(.state != "") | "\(.tab) (\(.state))"' |
      paste -sd, - | sed 's/,/, /g')
    what+=("kill the $term session '$name'${agents:+, with $agents}")
  fi
  if [[ -d $home ]]; then
    local -a briefs=($home/briefs/*(N)) reports=($home/reports/*(N))
    what+=("delete ${home/#$HOME/~} ($#briefs briefs, $#reports reports)")
  fi
  if [[ -z $yes ]]; then
    [[ -t 0 ]] || die "pass -y to remove '$name' without asking"
    print "cbar rm $name will:"
    print -l -- "  "${^what}
    if ! read -q "?go ahead? [y/N] "; then
      print "\nleft it alone"
      return 1
    fi
    print
  fi
  # unregister first: removing the session from inside it ends this process
  [[ -d $home ]] && rm -r -- $home
  print "removed $name"
  if [[ -n $running ]]; then
    if [[ $term == tmux ]]; then tm kill-session -t "=$name"; else rex kill $sid >/dev/null; fi
  fi
}

# cbar open [-n] NAME: -n prints the command instead of running it. tmux:
# switch this client inside tmux, else attach in this terminal.
cmd_open() {
  local dry= name term sid client
  [[ $1 == -n ]] && { dry=1; shift }
  name=$1
  [[ -z $name ]] && die "usage: cbar open NAME"
  term=$(toml_get $CROSSBAR/projects/$name/project.toml terminal 2>/dev/null)
  if [[ -z $term ]]; then
    if tmux_has $name; then term=tmux; else term=rex; fi
  fi
  local -a cmd
  if [[ $term == tmux ]]; then
    tmux_has $name || die "no tmux session '$name' (cbar new $name --tmux)"
    cmd=(tmux ${CROSSBAR_TMUX_SOCKET:+-L} $CROSSBAR_TMUX_SOCKET)
    if [[ -n $TMUX ]]; then cmd+=(switch-client -t "=$name"); else cmd+=(attach-session -t "=$name"); fi
  else
    sid=$(rex_session_id $name)
    [[ -n $sid ]] || die "no session '$name' (cbar new $name)"
    client=$(app_client)
    [[ -n $client ]] || die "no Rex app connected"
    cmd=(rex -C $client do session.select session_id=$sid)
  fi
  if [[ -n $dry ]]; then print -r -- "${(q-)cmd[@]}"; elif [[ $term == tmux ]]; then exec "${cmd[@]}"; else "${cmd[@]}" >/dev/null; fi
}

cmd_version() {
  [[ -f $CROSSBAR/version ]] && print -r -- "$(<$CROSSBAR/version)" || print "unknown (not installed by install)"
}

# cbar update: clone the latest main and run its installer
cmd_update() {
  local old new tmp
  old=$(cmd_version)
  tmp=$(mktemp -d) || die "no temp dir"
  if ! git clone -q --depth 1 $REPO $tmp/crossbar; then
    rm -rf $tmp; die "could not fetch $REPO"
  fi
  CROSSBAR_HOME=$CROSSBAR $tmp/crossbar/install >/dev/null
  local code=$?
  rm -rf $tmp
  (( code == 0 )) || die "install failed"
  new=$(cmd_version)
  if [[ $old == $new ]]; then print "already up to date: $new"; else print "updated: $old → $new"; fi
}

# agents: tabs of this pane's session, found by tab name

in_session() { [[ -n $(here_terminal) ]] || die "run this inside a project's tmux or Rex pane" }

# agent_find TASK: "<pane id>\t<state>" of the agent in tab TASK of this session
agent_find() {
  panes --here | jq -r --arg t "$1" 'select(.tab == $t and .label != "switchboard") | "\(.block_id)\t\(.state)"' | head -1
}

# agent_get TASK: set id and st for the agent in tab TASK, or die
agent_get() {
  local found
  found=$(agent_find $1)
  [[ -n $found ]] || die "no tab '$1' in this session (cbar agent ls)"
  id=${found%%$'\t'*} st=${found#*$'\t'}
}

agent_new() {
  local task wt=1 project home brief dir id line
  while (( $# )); do
    case $1 in
      --no-worktree) wt= ;;
      -*) die "unknown option '$1'" ;;
      *) task=$1 ;;
    esac
    shift
  done
  [[ -n $task ]] || die "usage: cbar agent new TASK [--no-worktree]"
  [[ $task =~ '^[A-Za-z0-9._-]+$' ]] || die "a task name is letters, digits, '.', '_' and '-'"
  in_session
  project=$(here_session) home=$CROSSBAR/projects/$project brief=$CROSSBAR/projects/$project/briefs/$task.md
  [[ -f $brief ]] || die "write the brief first: ${brief/#$HOME/~}"
  [[ -z $(agent_find $task) ]] || die "this session already has a tab '$task'"
  dir=$(toml_get $home/project.toml path) || dir=$PWD

  local -a cmd=(claude -n $task)
  [[ -n $wt ]] && cmd+=(-w $task)
  cmd+=("Read $brief and do the task it describes.")
  case $(here_terminal) in
    tmux)
      cmd[1]=$(claude_cmd)
      line=${(j: :)${(q)cmd}}
      id=$(tm new-window -d -t "$(tm display-message -p -t $TMUX_PANE '#{session_id}'):" -n $task -c $dir \
        -P -F '#{pane_id}') || die "could not open a tab"
      tm send-keys -t $id -l -- $line
      tm send-keys -t $id Enter
      ;;
    rex)
      line=${(j: :)${(q)cmd}}
      id=$(rex window new -s $REX_SESSION $task -c $dir --focus=false --json |
        jq -r '.block_ids[0] // .blocks[0].block_id // empty')
      [[ -n $id ]] || die "could not open a tab"
      sleep 0.5
      rex send -s $REX_SESSION -b $id "$line"$'\n'
      ;;
  esac
  print "started $task in a new tab ($id)"
}

agent_ls() {
  in_session
  panes --here | jq -r 'select(.state != "") | "\(.tab)\t\(.state)\t\(.since)\t\(.msg)"' |
    awk -F'\t' 'BEGIN { printf "%-20s %-8s %-5s %s\n", "TAB", "STATE", "SINCE", "MESSAGE" }
                { printf "%-20s %-8s %-5s %s\n", $1, $2, $3, $4 }'
}

agent_status() {
  local id st
  [[ -n $1 ]] || die "usage: cbar agent status TASK"
  in_session; agent_get $1
  print -r -- ${st:-none}
}

agent_tail() {
  local id st n=${2:-60}
  [[ -n $1 ]] || die "usage: cbar agent tail TASK [N]"
  in_session; agent_get $1
  if [[ $(here_terminal) == tmux ]]; then
    tm capture-pane -p -J -t $id -S -$n
  else
    rex capture -s $REX_SESSION -b $id
  fi | awk '{ line[NR] = $0 } /[^ \t]/ { last = NR } END { for (i = 1; i <= last; i++) print line[i] }' | tail -n $n
}

# Only type into an agent that is idle or done: a keystroke into one that is
# working or blocked can answer a permission prompt.
agent_send() {
  local id st task=$1
  shift
  [[ -n $task && -n $* ]] || die "usage: cbar agent send TASK TEXT"
  in_session; agent_get $task
  [[ $st == idle || $st == done ]] || die "$task is ${st:-not running Claude}; only type into an idle or done agent"
  if [[ $(here_terminal) == tmux ]]; then
    tm send-keys -t $id -l -- "$*"
    tm send-keys -t $id Enter
  else
    rex send -s $REX_SESSION -b $id "$*"$'\r'
  fi
}

agent_wait() {
  local id st task=$1 limit=${2:-600} start=$SECONDS
  [[ -n $task ]] || die "usage: cbar agent wait TASK [SECONDS]"
  in_session; agent_get $task
  # an agent just started has no state until Claude is up (give it a minute),
  # and can look idle for a moment before it takes up its prompt (look twice)
  local twice=
  while :; do
    while [[ $st == working ]] || { [[ -z $st ]] && (( SECONDS - start < 60 )) }; do
      (( SECONDS - start >= limit )) && { print -r -- "$task: still ${st:-starting} after ${limit}s"; return 2 }
      sleep 3
      agent_get $task
    done
    [[ -n $twice || -z $st ]] && break
    twice=1
    sleep 5
    agent_get $task
  done
  print -r -- "$task: ${st:-not running Claude}"
}

# merged REPO WORKTREE: whether the worktree's work is in REPO's default branch
# (its commit is), or its branch's PR has merged (a squash merge shows only there)
merged() {
  local repo=$1 wt=$2 head base branch
  head=$(git -C $wt rev-parse HEAD 2>/dev/null) || return 1
  base=$(git -C $repo symbolic-ref -q --short refs/remotes/origin/HEAD)
  for b in $base ${base#origin/} main master; do
    git -C $repo rev-parse -q --verify $b >/dev/null && git -C $repo merge-base --is-ancestor $head $b && return 0
  done
  branch=$(git -C $wt symbolic-ref -q --short HEAD) || return 1
  (( $+commands[gh] )) || return 1
  [[ $(cd $repo && gh pr view $branch --json state -q .state 2>/dev/null) == MERGED ]]
}

# cbar agent close [-f] TASK: close the agent's tab, then remove its worktree
# if it is clean and merged. Refuses an agent that is working or blocked, or
# has uncommitted changes, unless -f; -f never removes a worktree with work in it.
agent_close() {
  local force= task id st wid project repo wt dirty= branch lock pid
  [[ $1 == -f || $1 == --force ]] && { force=1; shift }
  task=$1
  [[ -n $task ]] || die "usage: cbar agent close [-f] TASK"
  in_session; agent_get $task
  wid=$(panes --here | jq -r --arg i "$id" 'select(.block_id == $i) | .window_id' | head -1)
  local mine=${TMUX_PANE:-$REX_BLOCK}
  [[ -n $(panes --here | jq -r --arg w "$wid" --arg m "$mine" 'select(.window_id == $w and .block_id == $m) | 1') ]] &&
    die "'$task' is this tab"
  project=$(here_session)
  repo=$(toml_get $CROSSBAR/projects/$project/project.toml path) || repo=$PWD
  wt=$repo/.claude/worktrees/$task
  [[ -d $wt ]] || wt=
  [[ -n $wt && -n $(git -C $wt status --porcelain 2>/dev/null) ]] && dirty=1
  if [[ -z $force ]]; then
    [[ $st == working || $st == blocked ]] && die "$task is $st; wait for it, or close it anyway with -f"
    [[ -n $dirty ]] && die "$task has uncommitted changes in ${wt/#$HOME/~}; commit them, or close it anyway with -f"
  fi

  if [[ $(here_terminal) == tmux ]]; then
    tm kill-window -t $wid || die "could not close the tab"
  else
    rex window close -s $REX_SESSION $wid >/dev/null || die "could not close the tab"
  fi
  print "closed $task"
  [[ -n $wt ]] || return 0

  if [[ -n $dirty ]]; then
    print "kept ${wt/#$HOME/~}: uncommitted changes"
    return 0
  fi
  branch=$(git -C $wt symbolic-ref -q --short HEAD)
  if ! merged $repo $wt; then
    print "kept ${wt/#$HOME/~}: ${branch:-its commit} is not merged"
    return 0
  fi
  # Claude locks its worktree while it runs: wait for it to exit, then the lock is stale
  lock=$(git -C $repo worktree list --porcelain | awk -v w="worktree $wt" '$0 == w { on = 1; next } /^worktree / { on = 0 } on && /^locked/')
  pid=${${lock#*\(pid }%% *}
  if [[ -n $lock ]]; then
    local tries=0
    while [[ $pid == <-> ]] && kill -0 $pid 2>/dev/null && (( tries++ < 25 )); do sleep 0.2; done
    if [[ $pid == <-> ]] && kill -0 $pid 2>/dev/null; then
      print "kept ${wt/#$HOME/~}: still in use by pid $pid"
      return 0
    fi
    git -C $repo worktree unlock $wt
  fi
  git -C $repo worktree remove $wt || { print "kept ${wt/#$HOME/~}: git would not remove it"; return 0 }
  if [[ -n $branch ]]; then
    git -C $repo branch -q -d $branch 2>/dev/null || git -C $repo branch -q -D $branch
  fi
  print "removed ${wt/#$HOME/~}${branch:+ and branch $branch}"
}

cmd_agent() {
  local sub=$1
  (( $# )) && shift
  case $sub in
    new) agent_new "$@" ;;
    ls) agent_ls ;;
    status) agent_status "$@" ;;
    tail) agent_tail "$@" ;;
    send) agent_send "$@" ;;
    wait) agent_wait "$@" ;;
    close) agent_close "$@" ;;
    ""|help|-h|--help) agent_usage ;;
    *) print -u2 "cbar: unknown agent command '$sub'"; agent_usage >&2; exit 1 ;;
  esac
}

case $1 in
  new) shift; cmd_new "$@" ;;
  operator) shift; cmd_operator "$@" ;;
  board) shift; cmd_board "$@" ;;
  ls) shift; cmd_ls "$@" ;;
  open) shift; cmd_open "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  agent) shift; cmd_agent "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  update) shift; cmd_update "$@" ;;
  version|--version) cmd_version ;;
  ""|help|-h|--help) usage ;;
  *) print -u2 "cbar: unknown command '$1'"; usage >&2; exit 1 ;;
esac
