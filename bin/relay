#!/usr/bin/env python3
"""relay: run a program (Claude Code) on a pty of its own and stand in for a
terminal that understands OSC 7501 program status, as Rex does, so Claude
reports its state and status message inside tmux too.

  relay COMMAND [ARGS...]

Claude asks the terminal `ESC ] 7501 ; ?` at startup and, when answered,
writes `ESC ] 7501 ; state=…:app=claude-code[:kind=…][:msg=<base64>]` as its
state changes. relay answers the question and writes the root status (the
one without an id) to the tmux pane's options @cbar_state, @cbar_kind,
@cbar_msg (base64, as sent) and @cbar_since, where switchboard reads it.
Everything else passes through untouched. Outside tmux it just runs COMMAND.

$CROSSBAR_TMUX_SOCKET names a tmux server other than the default (tmux -L).
"""
import fcntl
import os
import pty
import re
import select
import signal
import subprocess
import sys
import termios
import tty
from datetime import datetime, timezone

PANE = os.environ.get("TMUX_PANE", "")
SOCKET = os.environ.get("CROSSBAR_TMUX_SOCKET", "")
START = b"\x1b]7501;"
SEQ = re.compile(rb"\x1b\]7501;([^\x07\x1b]*)(?:\x07|\x1b\\)")
REPLY = b"\x1b]7501;?\x1b\\"
OPTIONS = ("@cbar_state", "@cbar_kind", "@cbar_msg", "@cbar_since")

helpers = []   # tmux processes not yet reaped
last = None    # the status last written, (state, kind, msg)


def tmux(*args):
    cmd = ["tmux", *(["-L", SOCKET] if SOCKET else []), *args]
    helpers[:] = [p for p in helpers if p.poll() is None]
    try:
        helpers.append(subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL))
    except OSError:
        pass


def publish(fields):
    """Write one status record's state to the pane's options."""
    global last
    if "id" in fields:   # a subagent's or a task's own record
        return
    state = fields.get("state", "")
    if state == "clear":
        last = None
        args = []
        for o in OPTIONS:
            args += ["set-option", "-p", "-u", "-t", PANE, o, ";"]
        tmux(*args[:-1])
        return
    now = (state, fields.get("kind", ""), fields.get("msg", ""))
    if now == last:
        return
    since = datetime.now(timezone.utc).isoformat() if not last or last[0] != state else None
    last = now
    args = []
    for o, v in zip(OPTIONS, now):
        args += ["set-option", "-p", "-t", PANE, o, v, ";"]
    if since:
        args += ["set-option", "-p", "-t", PANE, "@cbar_since", since, ";"]
    tmux(*args[:-1])


def parse(data):
    fields = {}
    for part in data.decode("utf-8", "replace").split(":"):
        k, _, v = part.partition("=")
        fields[k] = v
    return fields


def filter_output(buf, fd):
    """Take the OSC 7501 sequences out of BUF: answer the question, publish
    the statuses. Returns (bytes to pass on, bytes held for the next read)."""
    out, i = bytearray(), 0
    while True:
        j = buf.find(START, i)
        if j < 0:
            k = buf.rfind(b"\x1b", max(i, len(buf) - len(START)))
            if k >= 0 and START.startswith(buf[k:]):   # a sequence may start here
                return out + buf[i:k], buf[k:]
            return out + buf[i:], b""
        out += buf[i:j]
        m = SEQ.match(buf, j)
        if not m:
            if len(buf) - j > 8192:   # not ours after all
                return out + buf[j:], b""
            return out, buf[j:]
        data = m.group(1)
        if data.startswith(b"?"):
            os.write(fd, REPLY)
        else:
            publish(parse(data))
        i = m.end()


def copy_size(fd):
    try:
        size = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(fd, termios.TIOCSWINSZ, size)
    except OSError:
        pass


def write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.exit("usage: relay COMMAND [ARGS...]")
    if not PANE or not sys.stdin.isatty():
        os.execvp(argv[0], argv)

    pid, fd = pty.fork()
    if pid == 0:
        try:
            os.execvp(argv[0], argv)
        except OSError as e:
            print(f"relay: {argv[0]}: {e.strerror}", file=sys.stderr)
            os._exit(127)

    copy_size(fd)
    signal.signal(signal.SIGWINCH, lambda *_: copy_size(fd))
    stdin = sys.stdin.fileno()
    saved = termios.tcgetattr(stdin)
    tty.setraw(stdin)
    held = b""
    try:
        while True:
            try:
                # bytes held back as a possible start of OSC 7501 go out
                # anyway if nothing follows them soon
                ready, _, _ = select.select([stdin, fd], [], [], 0.05 if held else None)
            except InterruptedError:
                continue
            if not ready:
                write_all(sys.stdout.fileno(), held)
                held = b""
                continue
            if stdin in ready:
                data = os.read(stdin, 65536)
                if not data:
                    break
                write_all(fd, data)
            if fd in ready:
                try:
                    data = os.read(fd, 65536)
                except OSError:   # the program exited
                    data = b""
                if not data:
                    break
                out, held = filter_output(held + data, fd)
                write_all(sys.stdout.fileno(), out)
    finally:
        termios.tcsetattr(stdin, termios.TCSAFLUSH, saved)
        if held:
            write_all(sys.stdout.fileno(), held)
        if last:
            args = []
            for o in OPTIONS:
                args += ["set-option", "-p", "-u", "-t", PANE, o, ";"]
            tmux(*args[:-1])
        for p in helpers:
            try:
                p.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
    _, status = os.waitpid(pid, 0)
    sys.exit(os.waitstatus_to_exitcode(status) if hasattr(os, "waitstatus_to_exitcode") else 1)


if __name__ == "__main__":
    main()
