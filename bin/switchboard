#!/usr/bin/env python3
"""switchboard: live overview of every Rex and tmux session (one per project), and a way to jump to any pane.

Each session is a card; each pane a row with its tab name, program status
(idle / working / done / blocked / error) and how long it has been in that
state. Rex reports status via OSC 7501; in tmux it comes from `claude agents`,
matched to a pane by process.

  switchboard                 live view of every session
  switchboard --session NAME  live view of one session: a card per tab
  switchboard --here          same, for this pane's session ($TMUX_PANE or $REX_SESSION)
  switchboard --once          print once and exit (combines with the above)
  switchboard --json          print the panes as JSON and exit (combines with the above)

$CROSSBAR_TMUX_SOCKET names a tmux server other than the default (tmux -L).

Keys:  j/k ↑/↓ select · J/K tab/shift-tab next/prev session · g/G first/last
       enter jump to pane · 1-9 jump to session N · q/esc quit
       (scoped to one session, "session" above means tab; 0/~ jumps to the
       main switchboard, the one running without --here/--session)
Mouse: click a row to jump to that pane, click a card header to jump to that
       session, wheel moves the selection; scoped, click "↖ main" in the
       header to jump to the main switchboard.

Jumping asks the Rex app (a client) to show the session and tab with the
client action session.select, then focuses the pane with session.focus_block.
In tmux it selects the window and pane and switches this client (or, outside
tmux, the most recently active one) to the session.
"""
import base64
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import threading
import time
import tty
from collections import Counter
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

HOME = os.path.expanduser("~")
ME = os.getpid()
MY_BLOCK = os.environ.get("REX_BLOCK", "")
MY_PANE = os.environ.get("TMUX_PANE", "")
TMUX_SOCKET = os.environ.get("CROSSBAR_TMUX_SOCKET", "")
HIDE = {MY_BLOCK, MY_PANE} - {""}   # our own pane; --json shows it


def rgb(hex_, bg=False):
    r, g, b = (int(hex_[i:i + 2], 16) for i in (1, 3, 5))
    return f"\033[{48 if bg else 38};2;{r};{g};{b}m"


# CarbonFox
FG, SUBTLE, MUTED, FAINT = rgb("#f2f4f8"), rgb("#b6b8bb"), rgb("#7b7c7e"), rgb("#353535")
DIM = rgb("#525253")
ACCENT = rgb("#be95ff")
SEL = rgb("#2a2a2a", bg=True)
COLORS = {
    "blocked": rgb("#ee5396"),
    "error": rgb("#ff7eb6"),
    "done": rgb("#25be6a"),
    "working": rgb("#78a9ff"),
    "idle": MUTED,
}
BOLD, ITALIC, RESET = "\033[1m", "\033[3m", "\033[0m"
ORDER = ["blocked", "error", "done", "working", "idle"]
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
ANSI = re.compile(r"\033\[[0-9;]*m")


def run(*args):
    try:
        out = subprocess.run(["rex", *args], capture_output=True, text=True, timeout=5)
        return out.returncode, out.stdout, out.stderr.strip()
    except subprocess.TimeoutExpired:
        return 1, "", "timed out"
    except FileNotFoundError:
        return 1, "", "rex is not installed"


def rex(*args):
    code, out, _ = run(*args)
    try:
        return json.loads(out) if code == 0 and out.strip() else None
    except json.JSONDecodeError:
        return None


def text(value):
    """Free-text status values are base64 per the protocol; show them decoded."""
    if not value:
        return ""
    try:
        decoded = base64.b64decode(value + "=" * (-len(value) % 4), validate=True).decode()
        return decoded if decoded.isprintable() else value
    except (ValueError, UnicodeDecodeError):
        return value


def short(path):
    return "~" + path[len(HOME):] if path and path.startswith(HOME) else (path or "")


def age(stamp):
    if not stamp:
        return ""
    try:
        secs = (datetime.now(timezone.utc) - datetime.fromisoformat(stamp)).total_seconds()
    except ValueError:
        return ""
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return "now"


def pane(session_id, block, tabs):
    bid = block["block_id"]
    if bid in HIDE:
        return None
    proc = rex("block", "call", "-s", session_id, "-b", bid, "process") or {}
    fg = proc.get("foreground") or {}
    if fg.get("pid") == ME:
        return None
    status = rex("block", "call", "-s", session_id, "-b", bid, "program_status") or {}
    records = status.get("records") or []
    root = next((r for r in records if not r.get("id")), records[0] if records else {})
    # an interpreter running a script (python switchboard, …) is named after the script
    program = os.path.basename(fg.get("script") or fg.get("argv0") or fg.get("name") or "?").lstrip("-")
    return {
        "session_id": session_id,
        "block_id": bid,
        "window_id": block.get("window_id", ""),
        "tab": tabs.get(block.get("window_id"), ""),
        "label": block.get("label", ""),
        "program": program,
        "cwd": short(fg.get("cwd")),
        "state": root.get("state", ""),
        "kind": root.get("kind", ""),
        "msg": text(root.get("msg")),
        "since": age(root.get("updated_at")),
    }


def resolve(name):
    """The session NAME (a label or id), Rex or tmux; None if there is none.
    A name in both is taken from the one this pane runs in."""
    sessions = (rex("ls", "--json") or {}).get("sessions", [])
    pool = tmux_sessions() + sessions if MY_PANE else sessions + tmux_sessions()
    return next((s for s in pool if name in (s["session_id"], s.get("label"))), None)


def snapshot(scope=None):
    if scope:
        return tmux_snapshot(scope) if is_tmux(scope) else tabs_snapshot(scope)
    return rex_snapshot() + tmux_snapshot()


def rex_snapshot():
    sessions = (rex("ls", "--json") or {}).get("sessions", [])
    jobs = []
    with ThreadPoolExecutor(max_workers=16) as pool:
        for s in sessions:
            sid = s["session_id"]
            windows = (rex("window", "ls", "-s", sid, "--json") or {}).get("windows", [])
            tabs = {w["window_id"]: w.get("label", "") for w in windows}
            blocks = (rex("block", "ls", "-s", sid, "--json") or {}).get("blocks", [])
            blocks = [b for b in blocks if b.get("placement", "placed") == "placed"]
            jobs.append((s, [pool.submit(pane, sid, b, tabs) for b in blocks]))
        return [(s, [p for p in (f.result() for f in futures) if p]) for s, futures in jobs]


def tabs_snapshot(sid):
    """One session, grouped by tab: [(tab, panes)] in tab order. A tab is the
    window dict plus session_id."""
    windows = (rex("window", "ls", "-s", sid, "--json") or {}).get("windows", [])
    tabs = {w["window_id"]: w.get("label", "") for w in windows}
    blocks = (rex("block", "ls", "-s", sid, "--json") or {}).get("blocks", [])
    blocks = [b for b in blocks if b.get("placement", "placed") == "placed"]
    with ThreadPoolExecutor(max_workers=16) as pool:
        futures = [(b.get("window_id"), pool.submit(pane, sid, b, tabs)) for b in blocks]
        panes = [(wid, f.result()) for wid, f in futures]
    return [(dict(w, session_id=sid), [p for wid, p in panes if p and wid == w["window_id"]])
            for w in windows]


def is_main_board(sid, block):
    """Whether BLOCK runs the main switchboard: labelled switchboard, its
    foreground process the switchboard script, with no --here/--session.
    Rex reports argv0 only (for a script, often just the interpreter), so argv
    comes from ps (same host)."""
    if block.get("label") != "switchboard" or block.get("placement", "placed") != "placed":
        return False
    if block["block_id"] == MY_BLOCK:
        return False
    fg = (rex("block", "call", "-s", sid, "-b", block["block_id"], "process") or {}).get("foreground") or {}
    try:
        argv = subprocess.run(["ps", "-o", "args=", "-p", str(fg["pid"])],
                              capture_output=True, text=True, timeout=5).stdout.split()
    except (KeyError, subprocess.TimeoutExpired):
        return False
    i = next((k for k, a in enumerate(argv) if os.path.basename(a) == "switchboard"), None)
    if i is None:
        return False
    return not any(a in ("--here", "--session") or a.startswith("--session=") for a in argv[i + 1:])


def find_main(prefer=None):
    """(session id, session label, window id, block id) of the main switchboard,
    or None. Sessions are searched in order, PREFER (a session id) first; the
    terminal this pane runs in (tmux or Rex) before the other."""
    for look in (tmux_find_main, rex_find_main) if MY_PANE else (rex_find_main, tmux_find_main):
        hit = look(prefer)
        if hit:
            return hit
    return None


def rex_find_main(prefer=None):
    sessions = (rex("ls", "--json") or {}).get("sessions", [])
    sessions.sort(key=lambda s: s["session_id"] != prefer)
    for s in sessions:
        sid = s["session_id"]
        blocks = (rex("block", "ls", "-s", sid, "--json") or {}).get("blocks", [])
        for b in blocks:
            if is_main_board(sid, b):
                return sid, s.get("label") or sid[-6:], b.get("window_id"), b["block_id"]
    return None


def main_window(sid, bid):
    """The window BID is in if it still runs the main switchboard, else None."""
    if is_tmux(bid):
        code, out, _ = tmux("display-message", "-p", "-t", bid, "#{@cbar_role}\t#{window_id}")
        role, _, wid = out.strip().partition("\t")
        return wid if code == 0 and role == "main" and bid not in HIDE else None
    blocks = (rex("block", "ls", "-s", sid, "--json") or {}).get("blocks", [])
    block = next((b for b in blocks if b["block_id"] == bid), None)
    return block.get("window_id") if block and is_main_board(sid, block) else None


# tmux: one list-panes call per refresh. A Claude started through relay
# reports its status (OSC 7501, as in Rex) to its pane's options @cbar_state,
# @cbar_kind, @cbar_msg and @cbar_since. Any other Claude's comes from `claude
# agents`, matched to the pane whose process it descends from: idle, working or
# blocked, with no message. Switchboards mark their own pane with @cbar_role
# (main or local); cbar labels panes it makes with @cbar_label.
TMUX_FIELDS = ("session_id", "session_name", "window_id", "window_name", "pane_id",
               "pane_pid", "pane_current_command", "pane_current_path", "@cbar_label", "@cbar_role",
               "@cbar_state", "@cbar_kind", "@cbar_msg", "@cbar_since")
CLAUDE_STATES = {"busy": "working", "waiting": "blocked", "idle": "idle"}
SINCE = {}   # pane id → (state, when it was first seen in that state)


def tmux(*args):
    cmd = ["tmux", *(["-L", TMUX_SOCKET] if TMUX_SOCKET else []), *args]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return out.returncode, out.stdout, out.stderr.strip()
    except subprocess.TimeoutExpired:
        return 1, "", "timed out"
    except FileNotFoundError:
        return 1, "", "tmux is not installed"


def is_tmux(id_):
    return (id_ or "")[:1] in ("$", "@", "%")


def tmux_sessions():
    code, out, _ = tmux("list-sessions", "-F", "#{session_id}\t#{session_name}")
    if code != 0:
        return []
    return [{"session_id": i, "label": n, "mux": "tmux"}
            for i, _, n in (line.partition("\t") for line in out.splitlines())]


def tmux_rows():
    code, out, _ = tmux("list-panes", "-a", "-F", "\t".join("#{%s}" % f for f in TMUX_FIELDS))
    if code != 0:
        return []
    rows = [line.split("\t") for line in out.splitlines()]
    return [dict(zip(TMUX_FIELDS, r)) for r in rows if len(r) == len(TMUX_FIELDS)]


def claude_by_pane(pane_pids):
    """{pane pid: Claude session from `claude agents`} for panes running Claude."""
    try:
        sessions = json.loads(subprocess.run(["claude", "agents", "--json"], capture_output=True,
                                             text=True, timeout=5).stdout or "[]")
        ps = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True,
                            text=True, timeout=5).stdout
    except (subprocess.TimeoutExpired, FileNotFoundError, json.JSONDecodeError):
        return {}
    parent = {}
    for line in ps.splitlines():
        pid, _, ppid = line.strip().partition(" ")
        if pid.isdigit() and ppid.strip().isdigit():
            parent[int(pid)] = int(ppid)
    found = {}
    for s in sessions:
        pid, hops = s.get("pid"), 0
        while pid and pid not in pane_pids and hops < 16:
            pid, hops = parent.get(pid), hops + 1
        if pid in pane_pids:
            found.setdefault(pid, s)
    return found


def tmux_pane(row, claude):
    if row["pane_id"] in HIDE:
        return None
    s = claude.get(int(row["pane_pid"]) if row["pane_pid"].isdigit() else 0)
    state, kind, msg, since = row["@cbar_state"], row["@cbar_kind"], text(row["@cbar_msg"]), row["@cbar_since"]
    if not state and s:
        state = s["state"] if s.get("state") in ORDER else CLAUDE_STATES.get(s.get("status"), "")
        seen = SINCE.get(row["pane_id"])
        if not seen or seen[0] != state:
            seen = SINCE[row["pane_id"]] = (state, datetime.now(timezone.utc).isoformat() if seen else "")
        since = seen[1]
    role = row["@cbar_role"]
    return {
        "session_id": row["session_id"],
        "block_id": row["pane_id"],
        "window_id": row["window_id"],
        "tab": row["window_name"],
        "label": row["@cbar_label"] or ("switchboard" if role else "shell"),
        "program": "claude" if s or row["@cbar_state"] else ("switchboard" if role else row["pane_current_command"]),
        "cwd": short(row["pane_current_path"]),
        "state": state,
        "kind": kind,
        "msg": msg,
        "since": age(since),
    }


def tmux_snapshot(scope=None):
    """Like rex_snapshot, or with SCOPE (a session id) like tabs_snapshot."""
    rows = tmux_rows()
    claude = claude_by_pane({int(r["pane_pid"]) for r in rows if r["pane_pid"].isdigit()})
    sessions, windows = {}, {}
    for r in rows:
        sessions.setdefault(r["session_id"], {"session_id": r["session_id"],
                                              "label": r["session_name"], "mux": "tmux"})
        windows.setdefault(r["window_id"], {"window_id": r["window_id"], "label": r["window_name"],
                                            "session_id": r["session_id"], "mux": "tmux"})
    panes = [(r, tmux_pane(r, claude)) for r in rows]
    if scope:
        return [(w, [p for r, p in panes if p and r["window_id"] == wid])
                for wid, w in windows.items() if w["session_id"] == scope]
    return [(s, [p for r, p in panes if p and r["session_id"] == sid]) for sid, s in sessions.items()]


def tmux_find_main(prefer=None):
    rows = [r for r in tmux_rows() if r["@cbar_role"] == "main" and r["pane_id"] not in HIDE]
    rows.sort(key=lambda r: r["session_id"] != prefer)
    if not rows:
        return None
    r = rows[0]
    return r["session_id"], r["session_name"], r["window_id"], r["pane_id"]


def tmux_here():
    """This pane's tmux session id, or None outside tmux."""
    if not MY_PANE:
        return None
    code, out, _ = tmux("display-message", "-p", "-t", MY_PANE, "#{session_id}")
    return out.strip() if code == 0 and out.strip() else None


def tmux_jump(sid, window_id, block_id):
    """Show SID (and the tab, and the pane) in a tmux client: this one inside
    tmux, else the most recently active. Returns an error or None."""
    client = []
    if not MY_PANE:
        code, out, _ = tmux("list-clients", "-F", "#{client_activity}\t#{client_name}")
        clients = sorted((line.split("\t") for line in out.splitlines() if "\t" in line), reverse=True)
        if not clients:
            return "no tmux client attached (tmux attach)"
        client = ["-c", clients[0][1]]
    args = []
    if window_id:
        args += ["select-window", "-t", window_id, ";"]
    if block_id:
        args += ["select-pane", "-t", block_id, ";"]
    code, _, err = tmux(*args, "switch-client", *client, "-t", block_id or window_id or sid)
    return None if code == 0 else (err or "switch-client failed")


def app_client():
    """The Rex app to drive: prefer an app attached to our own session."""
    clients = (rex("client", "ls", "--json") or {}).get("clients", [])
    apps = [c for c in clients if (c.get("info") or {}).get("kind") == "app"
            and c.get("connection_state", "connected") == "connected"]
    mine = os.environ.get("REX_SESSION", "")
    apps.sort(key=lambda c: mine not in (c.get("session_ids") or []))
    return apps[0]["client_id"] if apps else None


def width(s):
    return len(ANSI.sub("", s))


def fit(s, n):
    """Cut plain text to n columns."""
    return s if len(s) <= n else s[:max(n - 1, 0)] + "…"


def rank(state):
    return ORDER.index(state) if state in ORDER else len(ORDER)


def glyph(state, tick):
    if state == "working":
        return SPINNER[tick % len(SPINNER)]
    return {"blocked": "◆", "error": "✗", "done": "✓", "idle": "○"}.get(state, "·")


def card(number, session, panes, cols, tick, selected, scoped=False):
    """Lines for one session card (or, scoped, one tab card), plus a target per
    line (what a click there means)."""
    panes = sorted(panes, key=lambda p: rank(p["state"]))
    top = panes[0]["state"] if panes else ""
    edge = COLORS.get(top, FAINT) if top in ("blocked", "error", "done", "working") else FAINT
    inner = cols - 4
    home = Counter(p["cwd"] for p in panes if p["cwd"]).most_common(1)
    home = home[0][0] if home else ""
    sid = session["session_id"]
    head_target = ("tab", sid, session["window_id"], None) if scoped else ("session", sid, None, None)

    num = f"{number} " if number <= 9 else ""
    tag = " tmux" if session.get("mux") == "tmux" and not scoped else ""
    title = f" {num}{session['label']}{tag} "
    path = fit(home, max(inner - len(title) - 4, 0))
    path_part = f" {path} " if path else ""
    rule = "─" * max(cols - 3 - len(title) - len(path_part) - 1, 1)
    lines = [f"{edge}╭─{RESET} {MUTED}{num}{RESET}{BOLD}{FG}{session['label']}{RESET}{DIM}{tag}{RESET} "
             f"{edge}{rule}{RESET}{MUTED}{path_part}{RESET}{edge}─╮{RESET}"]
    targets = [head_target]

    def row(content, target=None, hot=False):
        pad = max(inner - width(content), 0)
        if hot:
            content = content.replace(RESET, RESET + SEL)
            lines.append(f"{edge}│{RESET}{SEL}{ACCENT}▎{RESET}{SEL}{content}{' ' * pad} {RESET}{edge}│{RESET}")
        else:
            lines.append(f"{edge}│{RESET} {content}{' ' * pad} {edge}│{RESET}")
        targets.append(target)

    if not panes:
        row(f"{MUTED}{ITALIC}no panes{RESET}", head_target)
    agents_seen = False
    for p in panes:
        is_agent = bool(p["state"])
        if is_agent:
            agents_seen = True
        elif agents_seen:
            row(f"{FAINT}{'┄' * inner}{RESET}")
            agents_seen = False
        hot = p["block_id"] == selected
        target = ("pane", sid, p["window_id"], p["block_id"])
        color = COLORS.get(p["state"], MUTED)
        if scoped:   # the card is the tab; name the pane by its own label
            name = p["label"] if p["label"] not in ("", "shell") else p["program"]
        else:
            name = p["tab"] or p["program"]
        name = fit(name, 16)
        board = not is_agent and p["program"] == "switchboard"
        mark = glyph(p["state"], tick) if is_agent else ("◇" if board else "▪")
        word = p["state"] if is_agent else p["program"]
        right = p["since"] if is_agent else ("view" if board else "process")
        name_color = FG if is_agent or hot else MUTED
        mark_color = color if is_agent else (ACCENT if board else FAINT)
        left = (f"{mark_color}{mark}{RESET} {name_color}{BOLD if hot else ''}{name:<16}{RESET}"
                f" {color if is_agent else MUTED}{word}{RESET}")
        if p["cwd"] and p["cwd"] != home:
            room = inner - width(left) - len(right) - 3
            if room > 6:
                left += f"  {MUTED}{fit(p['cwd'], room)}{RESET}"
        gap = max(inner - width(left) - len(right), 1)
        row(f"{left}{' ' * gap}{MUTED if is_agent else FAINT}{right}{RESET}", target, hot)
        detail = " · ".join(x for x in (p["kind"], p["msg"]) if x)
        if detail and p["state"] in ("blocked", "error", "done"):
            row(f"  {color}{ITALIC}{fit(detail, inner - 2)}{RESET}", target, hot)
    lines.append(f"{edge}╰{'─' * (cols - 2)}╯{RESET}")
    targets.append(None)
    return lines, targets


MAIN_LINK = "↖ main"


def main_link_span(cols):
    """Columns [start, end) of the header's main link, in line coordinates."""
    cols = max(min(cols, 100), 36)
    end = cols - len(time.strftime("%H:%M")) - 2
    return end - len(MAIN_LINK), end


def render(data, cols, tick=0, selected=None, scope_label=None, link_hot=False):
    """Return (lines, targets): targets[i] is None, ("session", sid, None, None),
    ("tab", sid, window_id, None) or ("pane", sid, window_id, block_id) for screen
    line i. With scope_label, data is one session's tabs (see tabs_snapshot), and
    the header carries a link to the main switchboard, accent-colored if link_hot."""
    cols = max(min(cols, 100), 36)
    counts = Counter(p["state"] for _, panes in data for p in panes if p["state"])
    others = sum(1 for _, panes in data for p in panes if not p["state"])
    pills = "  ".join(
        f"{COLORS[s]}{glyph(s, tick)} {counts[s]} {s}{RESET}" for s in ORDER if counts.get(s)
    )
    if others:
        pills += f"{'  ' if pills else ''}{MUTED}▪ {others} other {'pane' if others == 1 else 'panes'}{RESET}"
    clock = time.strftime("%H:%M")
    subtitle = f"{scope_label} · tabs & agents" if scope_label else "agents & panes by session"
    head = f"{ACCENT}{BOLD}◇ switchboard{RESET} {MUTED}{subtitle}{RESET}"
    right = f"{MUTED}{clock}{RESET}"
    if scope_label:
        start, _ = main_link_span(cols)
        subtitle = fit(subtitle, max(start - len("◇ switchboard ") - 1, 1))
        head = f"{ACCENT}{BOLD}◇ switchboard{RESET} {MUTED}{subtitle}{RESET}"
        right = f"{ACCENT if link_hot else DIM}{MAIN_LINK}{RESET}  {right}"
        lines = [head + " " * max(start - width(head), 1) + right]
    else:
        lines = [head + " " * max(cols - width(head) - len(clock), 1) + right]
    lines += [pills or f"{MUTED}no agents{RESET}", ""]
    targets = [None, None, None]
    for n, (session, panes) in enumerate(data, 1):
        more, hits = card(n, session, panes, cols, tick, selected, scoped=bool(scope_label))
        lines += more
        targets += hits
    return lines, targets


def footer(cols, status, scoped=False):
    group = "tab" if scoped else "session"
    keys = [("↑↓", "select"), ("⇥", group), ("⏎", "jump"), ("1-9", group), ("click", "jump"), ("q", "quit")]
    if scoped:
        keys.insert(-1, ("0", "main"))
    hint = "  ".join(f"{MUTED}{k}{RESET} {DIM}{v}{RESET}" for k, v in keys)
    for spare in ("click", "⇥", "↑↓"):   # a narrow pane: drop hints rather than wrap
        if width(hint) <= cols:
            break
        keys = [(k, v) for k, v in keys if k != spare]
        hint = "  ".join(f"{MUTED}{k}{RESET} {DIM}{v}{RESET}" for k, v in keys)
    if status:
        color, msg = status
        msg = fit(msg, max(cols - width(hint) - 2, 12))
        gap = cols - width(hint) - len(msg)
        if gap < 2:
            return f"{color}{fit(msg, cols)}{RESET}"
        return hint + " " * gap + f"{color}{msg}{RESET}"
    return hint


class Board:
    """Selection, scrolling and jumping for the live view."""

    def __init__(self, scope=None, scope_label=None):
        self.scope, self.scope_label = scope, scope_label   # session id/label when scoped to one
        self.data, self.lock = [], threading.Lock()
        self.selected = None        # block_id
        self.targets = []           # per rendered line
        self.offset = 0             # scroll
        self.status, self.status_at = None, 0.0
        self.client = None
        self.focus_in = 0.0
        self.main = None            # cached find_main() result
        self.link_hover, self.link_at = False, 0.0   # main link: hovered, last clicked

    # data
    def refresh(self):
        while True:
            fresh = snapshot(self.scope)
            client = app_client()
            with self.lock:
                self.data, self.client = fresh, client
            time.sleep(2)

    def order(self):
        """Selectable panes in screen order, as (block_id, group): the group is the
        session id, or the tab (window id) when scoped to one session."""
        seen, out = set(), []
        for t in self.targets:
            if t and t[0] == "pane" and t[3] not in seen:
                seen.add(t[3])
                out.append((t[3], t[2] if self.scope else t[1]))
        return out

    def groups(self):
        """Number-key targets in card order."""
        with self.lock:
            if self.scope:
                return [("tab", g["session_id"], g["window_id"], None) for g, _ in self.data]
            return [("session", g["session_id"], None, None) for g, _ in self.data]

    def keep_selection(self):
        order = self.order()
        ids = [b for b, _ in order]
        if not ids:
            return
        if self.selected not in ids:
            # fall back to where it was, by screen position
            self.selected = ids[min(getattr(self, "_last_index", 0), len(ids) - 1)]
        self._last_index = ids.index(self.selected)

    # movement
    def move(self, step):
        ids = [b for b, _ in self.order()]
        if not ids:
            return
        i = ids.index(self.selected) if self.selected in ids else 0
        self.selected = ids[max(0, min(len(ids) - 1, i + step))]

    def edge(self, last):
        ids = [b for b, _ in self.order()]
        if ids:
            self.selected = ids[-1 if last else 0]

    def hop(self, step):
        """Select the first pane of the next/previous session that has panes."""
        order = self.order()
        if not order:
            return
        current = dict(order).get(self.selected, order[0][1])
        firsts = []
        for b, s in order:
            if not firsts or firsts[-1][1] != s:
                firsts.append((b, s))
        i = next((k for k, (_, s) in enumerate(firsts) if s == current), 0)
        self.selected = firsts[(i + step) % len(firsts)][0]

    def first_pane_of(self, group):
        return next((b for b, g in self.order() if g == group), None)

    # jumping
    def say(self, color, msg):
        self.status, self.status_at = (color, msg), time.time()

    def names(self, sid, bid=None, wid=None):
        with self.lock:
            if self.scope:
                tab = next((g.get("label", "") for g, _ in self.data if g["window_id"] == wid), "")
                p = next((p for _, ps in self.data for p in ps if p["block_id"] == bid), None)
                if p:
                    tab = " › ".join(x for x in (tab, p["label"] if p["label"] not in ("", "shell")
                                                 else p["program"]) if x)
                return self.scope_label, tab
            for s, panes in self.data:
                if s["session_id"] == sid:
                    p = next((p for p in panes if p["block_id"] == bid), None)
                    tab = (p["tab"] or p["program"]) if p else ""
                    return s["label"], tab
        return sid[-6:], ""

    def jump(self, sid, window_id=None, block_id=None):
        label, tab = self.names(sid, block_id, window_id)
        where = f"{label} › {tab}" if tab else label
        self.say(MUTED, f"→ {where}")
        threading.Thread(target=self._jump, args=(sid, window_id, block_id, where), daemon=True).start()

    def _jump(self, sid, window_id, block_id, where):
        """Show the session (and tab) in the app and focus the pane; True on success."""
        if is_tmux(sid):
            err = tmux_jump(sid, window_id, block_id)
            if err:
                self.say(COLORS["blocked"], f"✗ {err}")
                return False
            self.say(COLORS["done"], f"✓ {where}")
            return True
        with self.lock:
            client = self.client
        if not client:
            client = app_client()
        if not client:
            self.say(COLORS["blocked"], "✗ no Rex app connected")
            return False
        args = [f"session_id={sid}"] + ([f"window_id={window_id}"] if window_id else [])
        code, _, err = run("-C", client, "do", "session.select", *args)
        if code != 0:
            self.say(COLORS["blocked"], f"✗ {err or 'session.select failed'}")
            return False
        if block_id:
            code, _, err = run("focus", "-s", sid, block_id)
            if code != 0:
                self.say(COLORS["blocked"], f"✗ {err or 'focus failed'}")
                return False
            # check the server agrees: the tab is active and the pane focused
            view = rex("window", "ls", "-s", sid, "--json") or {}
            win = next((w for w in view.get("windows", []) if w["window_id"] == window_id), {})
            if view.get("active_window_id") != window_id or win.get("focused_block_id") != block_id:
                self.say(COLORS["error"], f"? {where}: focus did not stick")
                return False
        self.say(COLORS["done"], f"✓ {where}")
        return True

    def jump_main(self):
        """Jump to the main switchboard pane, found by find_main and cached."""
        self.link_at = time.time()
        self.say(MUTED, "→ main")
        threading.Thread(target=self._jump_main, daemon=True).start()

    def _jump_main(self):
        cached = self.main
        if cached:   # still there, still the main switchboard?
            sid, _, _, bid = cached
            wid = main_window(sid, bid)
            cached = (*cached[:2], wid, bid) if wid else None   # it may have moved tabs
        target = cached or find_main()
        self.main = target
        if not target:
            self.say(COLORS["blocked"], "✗ no main switchboard")
            return
        sid, label, wid, bid = target
        if not self._jump(sid, wid, bid, label) and cached:
            # the cached pane may have just gone; look again once
            target = self.main = find_main()
            if not target:
                self.say(COLORS["blocked"], "✗ no main switchboard")
                return
            sid, label, wid, bid = target
            self._jump(sid, wid, bid, label)

    def link_hot(self):
        return self.link_hover or time.time() - self.link_at < 0.6

    def on_link(self, x, line):
        """Whether screen position (x, line), 1-based x, is on the header's main link."""
        if not self.scope or self.offset + line != 0:
            return False
        start, end = main_link_span(shutil.get_terminal_size().columns - 2)
        return start <= x - 2 < end      # each screen line is drawn after one space

    def activate(self, target):
        kind, sid, wid, bid = target
        if kind == "pane":
            self.selected = bid
            self.jump(sid, wid, bid)
        elif kind == "tab":
            self.selected = self.first_pane_of(wid) or self.selected
            self.jump(sid, wid)
        else:
            self.selected = self.first_pane_of(sid) or self.selected
            self.jump(sid)

    # input
    def click(self, x, line, button, release):
        if button & 32:                              # motion: hover over the main link
            self.link_hover = self.on_link(x, line)
            return
        if release:
            return
        if button in (64, 65):                       # wheel
            self.move(-1 if button == 64 else 1)
            return
        if button != 0:
            return
        if self.on_link(x, line):
            if time.time() - self.focus_in >= 0.3:   # see below
                self.jump_main()
            return
        i = self.offset + line
        target = self.targets[i] if 0 <= i < len(self.targets) else None
        if not target:
            return
        if time.time() - self.focus_in < 0.3:
            # this click most likely just focused the pane: select, don't jump
            if target[0] == "pane":
                self.selected = target[3]
            return
        self.activate(target)

    def key(self, k):
        """Handle one key token; return False to quit."""
        if k in ("q", "esc", "\x03"):
            return False
        if k in ("j", "down"):
            self.move(1)
        elif k in ("k", "up"):
            self.move(-1)
        elif k in ("J", "tab", "right", "pgdn"):
            self.hop(1)
        elif k in ("K", "btab", "left", "pgup"):
            self.hop(-1)
        elif k in ("g", "home"):
            self.edge(False)
        elif k in ("G", "end"):
            self.edge(True)
        elif k in ("\r", "\n", "l", " "):
            order = dict(self.order())
            if self.selected in order:
                with self.lock:
                    p = next((p for _, ps in self.data for p in ps if p["block_id"] == self.selected), None)
                if p:
                    self.jump(p["session_id"], p["window_id"], p["block_id"])
        elif k in ("0", "~"):
            if self.scope:
                self.jump_main()
        elif k.isdigit():
            groups = self.groups()
            n = int(k) - 1
            if n < len(groups):
                self.activate(groups[n])
        return True


CSI_KEYS = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end", "Z": "btab",
            "5~": "pgup", "6~": "pgdn", "1~": "home", "4~": "end", "7~": "home", "8~": "end"}
SEQ = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])|\x1b\[([0-9;]*)([A-Za-z~])|\x1bO([A-Za-z])")


def tokens(buf):
    """Split raw input into key tokens and mouse/focus events."""
    out, i = [], 0
    while i < len(buf):
        if buf[i] == "\x1b":
            m = SEQ.match(buf, i)
            if not m:
                out.append("esc")
                i += 1
                continue
            if m.group(1):
                out.append(("mouse", int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4) == "m"))
            elif m.group(6):
                params, final = m.group(5), m.group(6)
                if final == "I":
                    out.append(("focus", True))
                elif final == "O":
                    out.append(("focus", False))
                else:
                    name = CSI_KEYS.get(final if final != "~" else params + "~")
                    if name:
                        out.append(name)
            else:
                name = CSI_KEYS.get(m.group(7))
                if name:
                    out.append(name)
            i = m.end()
        else:
            out.append("tab" if buf[i] == "\t" else buf[i])
            i += 1
    return out


def live(scope=None, scope_label=None):
    board = Board(scope, scope_label)
    threading.Thread(target=board.refresh, daemon=True).start()
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd) if os.isatty(fd) else None
    out = sys.stdout
    # alt screen, hide cursor, mouse clicks (+ motion, scoped, for the link's
    # hover) + SGR encoding, focus events
    motion = "\033[?1003h" if scope else ""
    out.write(f"\033[?1049h\033[?25l\033[?1000h{motion}\033[?1006h\033[?1004h")
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        if saved:
            tty.setcbreak(fd)
        tick = 0
        while True:
            size = shutil.get_terminal_size()
            cols, rows = size.columns - 2, max(size.lines - 1, 1)
            with board.lock:
                data = board.data
            if data:
                hot = board.link_hot()
                frame, board.targets = render(data, cols, tick, board.selected, scope_label, hot)
                board.keep_selection()
                frame, board.targets = render(data, cols, tick, board.selected, scope_label, hot)
            else:
                frame, board.targets = [f"{MUTED}loading…{RESET}"], [None]
            # keep the selected pane (and its detail line) on screen
            hit = [i for i, t in enumerate(board.targets) if t and t[0] == "pane" and t[3] == board.selected]
            if hit:
                if hit[0] < board.offset:
                    board.offset = max(hit[0] - 1, 0)       # include the card header
                elif hit[-1] >= board.offset + rows:
                    board.offset = hit[-1] - rows + 2
            board.offset = max(0, min(board.offset, max(len(frame) - rows, 0)))
            view = frame[board.offset: board.offset + rows]
            if board.status and time.time() - board.status_at > 3:
                board.status = None
            out.write("\033[H" + "".join(f" {line}\033[K\n" for line in view) + "\033[J"
                      + f"\033[{size.lines};1H {footer(cols, board.status, bool(scope))}\033[K")
            out.flush()
            tick += 1
            if not saved:
                time.sleep(0.12)
                continue
            if not select.select([fd], [], [], 0.12)[0]:
                continue
            raw = os.read(fd, 4096)
            if raw.endswith(b"\x1b") and select.select([fd], [], [], 0.03)[0]:
                raw += os.read(fd, 4096)                    # a split escape sequence
            going = True
            for tok in tokens(raw.decode("utf-8", "replace")):
                if isinstance(tok, tuple):
                    if tok[0] == "mouse":
                        _, button, x, y, release = tok
                        board.click(x, y - 1, button, release)
                    elif tok[0] == "focus" and tok[1]:
                        board.focus_in = time.time()
                    elif tok[0] == "focus":
                        board.link_hover = False
                elif not board.key(tok):
                    going = False
                    break
            if not going:
                break
    except KeyboardInterrupt:
        pass
    finally:
        if saved:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        out.write("\033[?1004l\033[?1006l\033[?1003l\033[?1000l\033[?25h\033[?1049l")
        out.flush()


def main():
    args = sys.argv[1:]
    scope = label = None
    if "--json" in args:
        HIDE.clear()
    if "--here" in args:
        scope = tmux_here() or os.environ.get("REX_SESSION")
        if not scope:
            sys.exit("switchboard: --here needs a tmux or Rex pane")
    elif "--session" in args:
        i = args.index("--session")
        if i + 1 >= len(args):
            sys.exit("usage: switchboard --session NAME")
        scope = args[i + 1]
    if scope:
        found = resolve(scope)
        if not found:
            sys.exit(f"switchboard: no session '{scope}'")
        scope, label = found["session_id"], found.get("label") or found["session_id"][-6:]
    if "--json" in args:
        print(json.dumps([{"group": g, "panes": panes} for g, panes in snapshot(scope)], indent=1))
    elif "--once" in args:
        print("\n".join(render(snapshot(scope), shutil.get_terminal_size().columns, scope_label=label)[0]))
    else:
        # in tmux, mark this pane so others can find the main switchboard
        marked = MY_PANE and tmux("set-option", "-p", "-t", MY_PANE, "@cbar_role",
                                  "local" if scope else "main")[0] == 0
        try:
            live(scope, label)
        finally:
            if marked:
                tmux("set-option", "-p", "-u", "-t", MY_PANE, "@cbar_role")


if __name__ == "__main__":
    main()
