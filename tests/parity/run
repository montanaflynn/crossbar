#!/usr/bin/env python3
"""Run the 0.4 crossbar (zsh cbar + Python switchboard) and the Rust one side by
side in a sandbox and diff what they print.

  tests/parity/run [options] NEW_CHECKOUT

NEW_CHECKOUT is a crossbar checkout with the Rust workspace; its cbar,
switchboard and claude-relay are built with cargo (--no-build uses what's in
its target/release). The old side is bin/cbar and bin/switchboard from --old
(default: main) of this repo.

  --old REF       the git ref of the old side (default main)
  --rex           run in a private Rex server instead of a private tmux server
  --only REGEX    run only the cases whose name matches
  --accept NAME   take a case's current diff as intended (writes intended.md;
                  repeatable, 'all' for every case that differs)
  --keep          keep the sandbox (its path is printed) instead of removing it
  --no-build      don't run cargo
  -v              print the diffs too, not only the summary

Each side gets its own sandbox: a scratch CROSSBAR_HOME under a scratch HOME,
its own tmux server (tmux -L) or Rex server (a private socket), and a stub in
place of claude (stub/claude) that reports the states its brief asks for. A
tmux run puts a `rex` on PATH that always fails, so neither side sees the live
Rex server. Everything a run starts is stopped when it ends, however it ends.

intended.md lists the differences that are meant to be there: per case, why,
and the diff it accepts (or "Any diff."). The summary says, per case:
  pass      the same output
  intended  differs exactly as intended.md says
  DIFF      differs, and intended.md doesn't accept it
  CHANGED   intended.md has an entry, but the diff isn't the accepted one
The exit status is 1 if any case is DIFF or CHANGED.
"""
import argparse
import base64
import difflib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
INTENDED = os.path.join(HERE, "intended.md")
OUT = os.path.join(HERE, "out")   # the last run's outputs (gitignored)
EXCHANGE = "central"   # the new side's exchange: 0.4's central keeps its name
PROJECTS = {"alpha": "repo-a", "beta": "repo-b"}   # project: its folder under HOME
AGENTS = {   # project: agent tabs started from fixtures/briefs, and the state each reports
    "alpha": {"t-done": "done", "t-ask": "blocked", "t-boom": "error", "t-busy": "working", "t-chat": "idle"},
    "beta": {"t-nogit": "done"},
}
VERBOSE = False


def say(*a):
    print(*a, file=sys.stderr, flush=True)


# ---- sandbox ------------------------------------------------------------------

class Cleanup:
    """What a run started, stopped in reverse order whatever happens."""

    def __init__(self):
        self.steps = []

    def add(self, what, fn):
        self.steps.append((what, fn))

    def run(self):
        while self.steps:
            what, fn = self.steps.pop()
            try:
                fn()
            except Exception as e:   # keep going: the rest must still stop
                say(f"parity: cleanup '{what}' failed: {e}")


CLEANUP = Cleanup()


def sh(argv, env=None, cwd=None, timeout=60, stdin=None, check=False):
    p = subprocess.run(argv, env=env, cwd=cwd, timeout=timeout, capture_output=True, text=True,
                       stdin=stdin if stdin is not None else subprocess.DEVNULL, start_new_session=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(argv)}: exit {p.returncode}: {p.stderr.strip()}")
    return p


def git(*args, **kw):
    return sh(["git", "-C", REPO, *args], **kw)


class Sandbox:
    """Files shared by both sides: the scratch HOME with the project folders,
    an empty ZDOTDIR, the stubs."""

    def __init__(self, root, rex):
        self.root = root
        self.home = os.path.join(root, "home")
        self.zdot = os.path.join(root, "zdot")
        self.stub = os.path.join(root, "stub")
        self.out = os.path.join(root, "out")
        self.rex = rex
        for d in (self.home, self.zdot, self.stub, self.out):
            os.makedirs(d)
        for f in (".zshenv", ".zprofile", ".zshrc", ".zlogin"):
            open(os.path.join(self.zdot, f), "w").close()
        with open(os.path.join(self.zdot, "shrc"), "w") as f:   # $ENV: what an interactive sh reads
            f.write("PS1='$ '\n")
        shutil.copy(os.path.join(HERE, "stub", "claude"), os.path.join(self.stub, "claude"))
        # a real repo for alpha (agents get -w), a plain folder for beta
        a = os.path.join(self.home, PROJECTS["alpha"])
        os.makedirs(a)
        g = ["git", "-C", a, "-c", "user.name=parity", "-c", "user.email=parity@example.invalid"]
        sh(g[:3] + ["init", "-q", "-b", "main"], check=True)
        sh(g + ["commit", "-q", "--allow-empty", "-m", "init"], check=True)
        os.makedirs(os.path.join(self.home, PROJECTS["beta"]))

    def short(self, path):
        return "~" + path[len(self.home):] if path.startswith(self.home) else path


def system_path():
    """A PATH with tmux, git, python3 and zsh and none of the user's own bin
    folders (where a real claude lives)."""
    dirs = []
    for prog in ("tmux", "git", "python3", "zsh", "base64"):
        found = shutil.which(prog)
        if not found:
            sys.exit(f"parity: needs {prog}")
        d = os.path.dirname(found)
        if d not in dirs and not d.startswith(os.path.expanduser("~")):
            dirs.append(d)
    for d in ("/usr/bin", "/bin", "/usr/sbin", "/sbin"):
        if d not in dirs:
            dirs.append(d)
    return ":".join(dirs)


# ---- the two sides -------------------------------------------------------------

class Side:
    def __init__(self, name, box, bin_dir, cb_home, rex):
        self.name = name   # old or new
        self.box = box
        self.bin = bin_dir
        self.cb = cb_home
        self.rex = rex
        self.sock = f"cbpar-{name}-{os.getpid()}"   # tmux -L
        self.rex_sock = os.path.join(box.root, f"rex-{name}.sock")
        self.stub = os.path.join(box.root, f"stub-{name}")   # PATH's first folder: claude and rex
        os.makedirs(self.stub)
        os.symlink(os.path.join(box.stub, "claude"), os.path.join(self.stub, "claude"))
        if rex:
            real = shutil.which("rex")
            if not real:
                sys.exit("parity: --rex needs rex")
            # rex ignores $REX_SERVER: every call names the private server, and never starts one
            with open(os.path.join(self.stub, "rex"), "w") as f:
                f.write(f'#!/bin/sh\nexec "{real}" --autostart=false -S "unix://{self.rex_sock}" "$@"\n')
            os.chmod(os.path.join(self.stub, "rex"), 0o755)
        else:
            shutil.copy(os.path.join(HERE, "stub", "rex-off"), os.path.join(self.stub, "rex"))
        self.env = {
            "HOME": box.home,
            "ZDOTDIR": box.zdot,
            "SHELL": "/bin/sh",
            "PATH": f"{self.stub}:{self.bin}:{system_path()}",
            "USER": os.environ.get("USER", ""),
            "LOGNAME": os.environ.get("LOGNAME", ""),
            "TMPDIR": os.environ.get("TMPDIR", "/tmp"),
            "TERM": "xterm-256color",
            "LANG": "en_US.UTF-8",
            "LC_ALL": "en_US.UTF-8",
            "COLUMNS": "100",
            "LINES": "50",
            "CROSSBAR_HOME": cb_home,
            "CROSSBAR_TMUX_SOCKET": self.sock,
            "CROSSBAR_CLAUDE": os.path.join(self.stub, "claude"),
            "CLAUDE_RELAY_PROGRAM": os.path.join(self.stub, "claude"),
            "CBAR_STUB_WORK": "2",
            **({"REX_SERVER": f"unix://{self.rex_sock}"} if rex else {}),   # for the real rex in Rex's panes
            "ENV": os.path.join(box.zdot, "shrc"),   # sh's prompt, if old cbar types into one: no host name
            "PS1": "$ ",
        }
        self.mux = Rex(self) if rex else Tmux(self)
        self.panes_at = {}   # project or "central": (session id, its operator's/supervisor's pane)

    # names of things on this side
    def session(self, project=None):
        if self.name == "old":
            return project or "central"
        return f"{EXCHANGE}/{project}" if project else EXCHANGE

    def briefs(self, project):
        if self.name == "old":
            return os.path.join(self.cb, "projects", project, "briefs")
        return os.path.join(self.cb, "exchanges", EXCHANGE, "projects", project, "briefs")

    def run(self, argv, pane=None, timeout=60, stdin=None):
        env = dict(self.env)
        if pane:
            env.update(self.mux.pane_env(*self.panes_at[pane]))
        argv = [os.path.join(self.bin, argv[0]) if argv[0] in ("cbar", "switchboard") else argv[0], *argv[1:]]
        try:
            p = sh(argv, env=env, cwd=self.box.home, timeout=timeout, stdin=stdin)
            return p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired as e:
            out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
            err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
            return "timeout", out, err


class Tmux:
    def __init__(self, side):
        self.side = side

    def __call__(self, *args, check=False):
        return sh(["tmux", "-L", self.side.sock, *args], env=self.side.env, check=check)

    def start(self):
        CLEANUP.add(f"tmux server {self.side.sock}", self.stop)

    def stop(self):
        self("kill-server")
        path = f"/private/tmp/tmux-{os.getuid()}/{self.side.sock}"
        if os.path.exists(path):
            os.unlink(path)

    def pane_env(self, sid, pane):
        return {"TMUX_PANE": pane, "TMUX": f"/private/tmp/tmux-{os.getuid()}/{self.side.sock},0,0"}

    def panes(self):
        """[{session, sid, tab, pane, label, state, msg}] for every pane."""
        fields = ["session_name", "session_id", "window_name", "pane_id", "@cbar_label", "@cbar_state", "@cbar_msg"]
        p = self("list-panes", "-a", "-F", "\t".join("#{%s}" % f for f in fields))
        out = []
        for line in p.stdout.splitlines():
            r = line.split("\t")
            if len(r) == len(fields):
                out.append({"session": r[0], "sid": r[1], "tab": r[2], "pane": r[3], "label": r[4],
                            "state": r[5], "msg": decode(r[6])})
        return out

    def new_session(self, name, tab, cwd, argv):
        p = self("new-session", "-d", "-s", name, "-n", tab, "-c", cwd, "-x", "200", "-y", "50",
                 "-P", "-F", "#{pane_id}", *argv, check=True)
        return p.stdout.strip()

    def split(self, name, pane, cwd, argv, label):
        p = self("split-window", "-h", "-d", "-l", "30%", "-t", pane, "-c", cwd, "-P", "-F", "#{pane_id}",
                 *argv, check=True)
        board = p.stdout.strip()
        self("set-option", "-p", "-t", board, "@cbar_label", label)
        return board

    def send_line(self, sid, pane, text):
        self("send-keys", "-t", pane, "-l", "--", text)
        time.sleep(0.4)
        self("send-keys", "-t", pane, "Enter")


class Rex:
    def __init__(self, side):
        self.side = side
        self.server = None

    def __call__(self, *args, check=False):
        return sh(["rex", *args], env=self.side.env, check=check)

    def json(self, *args):
        p = self(*args)
        try:
            return json.loads(p.stdout) if p.returncode == 0 and p.stdout.strip() else {}
        except json.JSONDecodeError:
            return {}

    def start(self):
        real = shutil.which("rex")
        state = os.path.join(self.side.box.root, f"rex-state-{self.side.name}")
        config = os.path.join(self.side.box.root, "rex-init.lua")
        open(config, "w").close()
        log = open(os.path.join(self.side.box.root, f"rex-{self.side.name}.log"), "w")
        self.server = subprocess.Popen(
            [real, "--autostart=false", "server", "run", "--listen", f"unix://{self.side.rex_sock}",
             "--state-dir", state, "--restore=false", "--config", config],
            env=self.side.env, stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
        CLEANUP.add(f"rex server {self.side.rex_sock}", self.stop)
        for _ in range(50):
            if self("ls", "--json").returncode == 0:
                break
            time.sleep(0.2)
        else:
            raise RuntimeError(f"the private Rex server didn't start (see {log.name})")
        self.check_shell()

    def check_shell(self):
        """What runs in a Rex pane gets your login environment, with Rex's own
        bin folder first: make sure that, in a shell pane and in a pane running
        a command, claude is the stub, claude-relay runs the stub, the crossbar
        settings carry over and rex reaches this private server (through
        $REX_SERVER), or stop before anything types `claude` into a pane."""
        root = self.side.box.root
        report = 'echo "claude=$(command -v claude)"; echo "relay=$CLAUDE_RELAY_PROGRAM"; ' \
                 'echo "home=$CROSSBAR_HOME"; echo "sessions=$(rex --autostart=false ls --json | grep -c session_id)"'
        probes = {"shell": os.path.join(root, f"probe-{self.side.name}-shell"),
                  "command": os.path.join(root, f"probe-{self.side.name}-command")}
        self("new", "_probe_shell", "-c", self.side.box.home, "--json", check=True)
        self("new", "_probe_command", "-c", self.side.box.home, "--json", "--", "/bin/sh", "-c",
             f"{{ {report}; }} > {probes['command']}.tmp; mv {probes['command']}.tmp {probes['command']}; sleep 30",
             check=True)
        time.sleep(1)
        self("send", "-s", "_probe_shell", f"{{ {report}; }} > {probes['shell']}.tmp; mv {probes['shell']}.tmp {probes['shell']}\r")
        for _ in range(75):
            if all(os.path.exists(p) for p in probes.values()):
                break
            time.sleep(0.2)
        for name in ("_probe_shell", "_probe_command"):
            sid = self.session_id(name)
            if sid:
                self("kill", sid)
        want = {"claude": os.path.join(self.side.stub, "claude"), "relay": os.path.join(self.side.stub, "claude"),
                "home": self.side.cb, "sessions": "2"}
        for kind, probe in probes.items():
            got = dict(l.split("=", 1) for l in open(probe).read().splitlines() if "=" in l) if os.path.exists(probe) else {}
            bad = {k: got.get(k, "nothing") for k, v in want.items() if got.get(k) != v}
            if bad:
                raise RuntimeError(f"in a Rex {kind} pane, {bad} isn't the sandbox's ({want}); "
                                   f"not running Rex cases")

    def stop(self):
        if self.server and self.server.poll() is None:
            os.killpg(self.server.pid, signal.SIGTERM)
            try:
                self.server.wait(10)
            except subprocess.TimeoutExpired:
                os.killpg(self.server.pid, signal.SIGKILL)

    def session_id(self, name):
        for s in self.json("ls", "--json").get("sessions", []):
            if s.get("label") == name:
                return s["session_id"]
        return None

    def pane_env(self, sid, pane):
        return {"REX_SESSION": sid, "REX_BLOCK": pane}

    def panes(self):
        out = []
        for s in self.json("ls", "--json").get("sessions", []):
            sid = s["session_id"]
            tabs = {w["window_id"]: w.get("label", "") for w in self.json("window", "ls", "-s", sid, "--json").get("windows", [])}
            for b in self.json("block", "ls", "-s", sid, "--json").get("blocks", []):
                if b.get("placement", "placed") != "placed":
                    continue
                recs = self.json("block", "call", "-s", sid, "-b", b["block_id"], "program_status").get("records") or []
                root = next((r for r in recs if not r.get("id")), {})
                out.append({"session": s.get("label", ""), "sid": sid, "tab": tabs.get(b.get("window_id"), ""),
                            "pane": b["block_id"], "label": b.get("label", ""), "state": root.get("state", ""),
                            "msg": root.get("msg", "")})
        return out

    def new_session(self, name, tab, cwd, argv):
        v = json.loads(self("new", name, "-c", cwd, "--window", tab, "--json", "--", *argv, check=True).stdout)
        return v["initial_windows"][0]["block_ids"][0]

    def split(self, name, pane, cwd, argv, label):
        v = json.loads(self("split", "-s", name, "-b", pane, "-c", cwd, "--split=right", "--ratio", "30",
                            "--focus=false", "--label", label, "--json", "--", *argv, check=True).stdout)
        return v["block_ids"][0]

    def send_line(self, sid, pane, text):
        self("send", "-s", sid, "-b", pane, text)
        time.sleep(0.4)
        self("send", "-s", sid, "-b", pane, "\r")


def decode(v):
    if not v:
        return ""
    try:
        return base64.b64decode(v + "=" * (-len(v) % 4), validate=True).decode()
    except ValueError:
        return v


# ---- building each side ---------------------------------------------------------

def build_old(box, ref, rex):
    bin_dir = os.path.join(box.root, "old", "bin")
    os.makedirs(bin_dir)
    for f in ("cbar", "switchboard"):
        p = git("show", f"{ref}:bin/{f}", check=True)
        path = os.path.join(bin_dir, f)
        with open(path, "w") as out:
            out.write(p.stdout)
        os.chmod(path, 0o755)
    cb = os.path.join(box.home, ".crossbar-old")
    os.makedirs(os.path.join(cb, "projects"))
    with open(os.path.join(cb, "operator.md"), "w") as out:
        out.write(git("show", f"{ref}:operator.md", check=True).stdout)
    return Side("old", box, bin_dir, cb, rex)


def build_new(box, checkout, build, rex):
    if not os.path.isfile(os.path.join(checkout, "crossbar", "Cargo.toml")):
        sys.exit(f"parity: {checkout} has no crossbar/Cargo.toml (not a 0.5 checkout)")
    if build:
        say(f"parity: building {checkout} (cargo build --release)")
        p = subprocess.run(["cargo", "build", "--release", "--workspace", "-q"], cwd=checkout)
        if p.returncode != 0:
            sys.exit("parity: cargo build failed")
    target = os.path.join(checkout, "target", "release")
    bin_dir = os.path.join(box.root, "new", "bin")
    os.makedirs(bin_dir)
    for f in ("cbar", "switchboard", "claude-relay"):
        src = os.path.join(target, f)
        if not os.path.isfile(src):
            sys.exit(f"parity: no {src} (build it, or drop --no-build)")
        shutil.copy2(src, os.path.join(bin_dir, f))
    cb = os.path.join(box.home, ".crossbar-new")
    os.makedirs(cb)
    return Side("new", box, bin_dir, cb, rex)


# ---- setting up a side's world ----------------------------------------------------

SETUP = {}   # case name: (side: (code, out, err)), from setup steps compared as cases


def setup(side):
    """Central/the exchange with its supervisor and main board, projects alpha
    and beta with operators and local boards, and the agents in AGENTS."""
    s, box = side, side.box
    s.mux.start()
    term = "--rex" if s.rex else "--tmux"
    if s.name == "old":
        # 0.4 had no `cbar up`: central was built by hand, as the live one was
        sup = s.mux.new_session("central", "supervisor", box.home,
                                [os.path.join(s.bin, "claude-relay"), "-n", "supervisor"])
        s.mux.split("central", sup, box.home, [os.path.join(s.bin, "switchboard")], "switchboard")
    else:
        record("new-exchange", s, s.run(["cbar", "new", "--exchange", EXCHANGE, term]))
    for project, folder in PROJECTS.items():
        record(f"new-project-{project}", s, s.run(["cbar", "new", project, os.path.join(box.home, folder), term]))
    want = {(s.session(), "supervisor"): "idle"}
    want.update({(s.session(p), "operator"): "idle" for p in PROJECTS})
    wait_states(s, want)
    locate(s)
    for project, agents in AGENTS.items():
        os.makedirs(s.briefs(project), exist_ok=True)
        for task in agents:
            shutil.copy(os.path.join(HERE, "fixtures", "briefs", f"{task}.md"), s.briefs(project))
            if project in s.panes_at:
                record(f"agent-new-{task}", s, s.run(["cbar", "agent", "new", task], pane=project))
            want[(s.session(project), task)] = agents[task]
    wait_states(s, want)


def record(name, side, result):
    SETUP.setdefault(name, {})[side.name] = result


def locate(side):
    """The supervisor's and each operator's pane, for commands run 'in' them."""
    for p in side.mux.panes():
        for project in [None, *PROJECTS]:
            tab = "operator" if project else "supervisor"
            if p["session"] == side.session(project) and p["tab"] == tab and p["label"] != "switchboard":
                side.panes_at.setdefault(project or "central", (p["sid"], p["pane"]))


def wait_states(side, want, limit=30):
    """Wait until each (session, tab) in WANT reports its state."""
    end = time.time() + limit
    while True:
        have = {(p["session"], p["tab"]): p["state"] for p in side.mux.panes() if p["label"] != "switchboard"}
        missing = {k: v for k, v in want.items() if have.get(k) != v}
        if not missing or time.time() > end:
            break
        time.sleep(0.5)
    for (session, tab), state in missing.items():
        say(f"parity: {side.name}: {session} {tab} is '{have.get((session, tab), 'missing')}', not {state}")
    return not missing


# ---- cases -------------------------------------------------------------------------

class Case:
    """OLD and NEW are argvs ('cbar …', 'switchboard …'); NEW defaults to OLD.
    PANE runs them as if typed in that project's operator pane (or 'central':
    the supervisor's). KIND says how output is compared: text, color (styles
    kept) or json. BEFORE/AFTER are hooks run on a side around the command."""

    def __init__(self, name, old, new=None, pane=None, kind="text", stdin=None, timeout=60, run=None):
        self.name, self.old, self.new = name, old, new or old
        self.pane, self.kind, self.stdin, self.timeout, self.runner = pane, kind, stdin, timeout, run

    def argv(self, side):
        return self.old if side.name == "old" else self.new

    def execute(self, side):
        if self.runner:
            return self.runner(self, side)
        return side.run(self.argv(side), pane=self.pane, timeout=self.timeout, stdin=self.stdin)


def watch_case(case, side):
    """cbar watch in alpha's operator pane, while t-chat is sent a line and
    t-done is closed."""
    env = dict(side.env)
    env.update(side.mux.pane_env(*side.panes_at["alpha"]))
    log = os.path.join(side.box.root, f"watch-{side.name}.out")
    with open(log, "w") as out, open(log + ".err", "w") as err:
        p = subprocess.Popen([os.path.join(side.bin, "cbar"), "watch"], env=env, cwd=side.box.home,
                             stdout=out, stderr=err, stdin=subprocess.DEVNULL, start_new_session=True)
    CLEANUP.add(f"{side.name} watch", lambda: p.poll() is None and os.killpg(p.pid, signal.SIGKILL))
    time.sleep(6)
    chat = next((x for x in side.mux.panes() if x["session"] == side.session("alpha") and x["tab"] == "t-chat"), None)
    if chat:
        side.mux.send_line(chat["sid"], chat["pane"], "ping")
    time.sleep(10)
    record("watch-close-t-done", side, side.run(["cbar", "agent", "close", "t-done"], pane="alpha"))
    time.sleep(10)
    if p.poll() is None:
        os.killpg(p.pid, signal.SIGTERM)
    code = p.wait(10)
    return ("watch ran" if code in (-signal.SIGTERM, 0, 143) else code), open(log).read(), open(log + ".err").read()


def path_new_case(case, side):
    """An agent started by its path with a brief to copy (new), against `agent new` (old)."""
    brief = os.path.join(HERE, "fixtures", "briefs", "t-path.md")
    if side.name == "old":
        os.makedirs(side.briefs("alpha"), exist_ok=True)
        shutil.copy(brief, side.briefs("alpha"))
        return side.run(["cbar", "agent", "new", "t-path"], pane="alpha")
    return side.run(["cbar", "new", "alpha/t-path", brief])


def watch_restart_case(case, side):
    """cbar watch started again after the first one: what it prints at startup
    (the addendum: what is blocked or in error again, not a done it already printed)."""
    env = dict(side.env)
    env.update(side.mux.pane_env(*side.panes_at["alpha"]))
    log = os.path.join(side.box.root, f"watch2-{side.name}.out")
    with open(log, "w") as out, open(log + ".err", "w") as err:
        p = subprocess.Popen([os.path.join(side.bin, "cbar"), "watch"], env=env, cwd=side.box.home,
                             stdout=out, stderr=err, stdin=subprocess.DEVNULL, start_new_session=True)
    CLEANUP.add(f"{side.name} watch again", lambda: p.poll() is None and os.killpg(p.pid, signal.SIGKILL))
    time.sleep(8)
    if p.poll() is None:
        os.killpg(p.pid, signal.SIGTERM)
    code = p.wait(10)
    return ("watch ran" if code in (-signal.SIGTERM, 0, 143) else code), open(log).read(), open(log + ".err").read()


def leftovers(side):
    """What of this side still runs 2s after its tmux or Rex server stopped:
    nothing should, as every pane's terminal is gone."""
    time.sleep(2)
    pids = set()
    for mark in (side.bin, side.stub):
        pids |= {x for x in sh(["pgrep", "-f", mark]).stdout.split() if x.isdigit()}
    if not pids:
        return 0, "", ""
    ps = sh(["ps", "-o", "args=", "-p", ",".join(sorted(pids))]).stdout
    return len(pids), "".join(sorted(ps.splitlines(True))), ""


def setup_case(case, side):
    return SETUP.get(case.name, {}).get(side.name, ("not run", "", ""))


def cases():
    alpha = ["--session", "alpha"]
    C = Case
    return [
        # what setup printed
        *[C(f"new-project-{p}", None, run=setup_case) for p in PROJECTS],
        *[C(f"agent-new-{t}", None, run=setup_case) for ts in AGENTS.values() for t in ts],
        # read-only
        C("help", ["cbar", "help"]),
        C("help-agent", ["cbar", "agent", "help"]),
