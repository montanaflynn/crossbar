# ---- normalizing -------------------------------------------------------------------

ANSI = re.compile(r"\x1b\[([0-9;]*)m")
OSC = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
STRIP_RULES = {   # rule: (side it applies to, pattern removed from stderr) — intended.md lists these
    "deprecation-note": ("new", re.compile(r"^cbar: `[^`]*` is deprecated; use `[^`]*`\n?", re.M)),
}


def styled(text):
    """TEXT with its SGR colors as [fg=#rrggbb b i] … [/] runs, whatever
    sequences produced them (spaces only carry a background)."""
    out_lines = []
    style = {}
    for line in text.split("\n"):
        runs, pos = [], 0
        for m in list(ANSI.finditer(line)) + [None]:
            chunk = line[pos:m.start()] if m else line[pos:]
            for ch in chunk:
                key = tuple(sorted((k, v) for k, v in style.items() if ch != " " or k == "bg"))
                if runs and runs[-1][0] == key:
                    runs[-1][1] += ch
                else:
                    runs.append([key, ch])
            if not m:
                break
            pos = m.end()
            sgr(style, m.group(1))
        out_lines.append("".join(f"[{' '.join(f'{k}={v}' if v is not True else k for k, v in key)}]{s}[/]"
                                 if key else s for key, s in runs))
    return "\n".join(out_lines)


def sgr(style, params):
    ps = [int(x) if x.isdigit() else 0 for x in (params or "0").split(";")]
    i = 0
    while i < len(ps):
        p = ps[i]
        if p == 0:
            style.clear()
        elif p in (1, 2, 3, 4):
            style[{1: "b", 2: "dim", 3: "i", 4: "u"}[p]] = True
        elif p == 22:
            style.pop("b", None); style.pop("dim", None)
        elif p in (23, 24):
            style.pop({23: "i", 24: "u"}[p], None)
        elif p in (38, 48) and i + 4 < len(ps) and ps[i + 1] == 2:
            style["fg" if p == 38 else "bg"] = "#%02x%02x%02x" % tuple(ps[i + 2:i + 5])
            i += 4
        elif p in (38, 48) and i + 2 < len(ps) and ps[i + 1] == 5:
            style["fg" if p == 38 else "bg"] = f"c{ps[i + 2]}"
            i += 2
        elif p in (39, 49):
            style.pop("fg" if p == 39 else "bg", None)
        elif 30 <= p <= 37 or 90 <= p <= 97:
            style["fg"] = f"c{p}"
        elif 40 <= p <= 47 or 100 <= p <= 107:
            style["bg"] = f"c{p}"
        i += 1


def names(side, text):
    """The exchange naming: 0.4's `central` is the exchange `central`, and
    project `alpha`'s session is `central/alpha`. Applied to the old side."""
    if side.name != "old":
        return text
    ps = "|".join(PROJECTS)
    text = re.sub(rf"(session '|\"label\": \"|=)({ps})\b", rf"\1{EXCHANGE}/\2", text)
    for d in ("projects", "central"):
        to = f"exchanges/{EXCHANGE}/projects" if d == "projects" else f"exchanges/{EXCHANGE}"
        text = text.replace(f"~/.crossbar/{d}/", f"~/.crossbar/{to}/")
    return text


def common(side, text):
    box = side.box
    text = OSC.sub("", text)
    for path, to in ((side.cb, "~/.crossbar"), (side.bin, "$BIN"), (side.stub, "$STUB"), (box.home, "~"),
                     (box.root, "$SANDBOX")):
        text = text.replace(path, to).replace(os.path.realpath(path), to)
    text = text.replace(box.short(side.cb), "~/.crossbar")
    text = text.replace(side.sock, "$SOCK")
    text = re.sub(r"\b\d\d:\d\d\b", "HH:MM", text)
    text = re.sub(r"(?<![\w.])%\d+\b", "%N", text)
    text = re.sub(r"(?<![\w.])@\d+\b", "@N", text)
    text = re.sub(r"(?<![\w.])\$\d+\b", "$N", text)
    text = re.sub(r"\b(session|window|block|client):[0-9a-f-]{36}\b", r"\1:ID", text)
    return names(side, text)


def canon_json(text):
    """Groups by label, panes by tab and label, keys sorted, ids and ages
    replaced; None if TEXT isn't JSON."""
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return None
    if isinstance(data, list):
        for g in data:
            if isinstance(g, dict):
                for p in g.get("panes", []):
                    if isinstance(p, dict) and p.get("since"):
                        p["since"] = "<age>"
                g.get("panes", []).sort(key=lambda p: (p.get("tab", ""), p.get("label", ""), p.get("program", "")))
        data.sort(key=lambda g: (g.get("group", {}) or {}).get("label", "") if isinstance(g, dict) else "")
    return json.dumps(data, indent=1, sort_keys=True, ensure_ascii=False)


def normalize(case, side, result):
    code, out, err = result
    fired = []
    for rule, (who, pat) in STRIP_RULES.items():
        if who == side.name and pat.search(err):
            err = pat.sub("", err)
            fired.append(rule)
    if case.kind == "color":
        out = styled(out)
    else:
        out = ANSI.sub("", out)
    out, err = common(side, out), common(side, ANSI.sub("", err))
    if case.kind == "json":
        out = canon_json(out) or out
    text = out.rstrip("\n") + "\n"
    if err.strip():
        text += "--- stderr\n" + err.rstrip("\n") + "\n"
    text += f"--- exit {code}\n"
    return text, fired


# ---- intended differences ------------------------------------------------------------

def read_intended():
    """{case: {"why": str, "diff": str or None (any diff)}} and the file's text."""
    if not os.path.exists(INTENDED):
        return {}, ""
    text = open(INTENDED).read()
    out = {}
    for block in re.split(r"^## ", text, flags=re.M)[1:]:
        name, _, body = block.partition("\n")
        name = name.strip()
        if name.startswith("Normalization"):
            continue
        m = re.search(r"^```diff\n(.*?)^```", body, re.S | re.M)
        why = re.sub(r"^```diff\n.*?^```\n?", "", body, flags=re.S | re.M).strip()
        out[name] = {"why": why, "diff": m.group(1) if m else None}
    return out, text


def write_intended(entries, accept):
    _, text = read_intended()
    head = text.split("\n## ", 1)[0] if text else "# Intended differences\n"
    rules = re.search(r"^## Normalization.*?(?=^## |\Z)", text, re.S | re.M)
    parts = [head.rstrip("\n") + "\n"]
    if rules:
        parts.append(rules.group(0).rstrip("\n") + "\n")
    for name in sorted(set(entries) | set(accept)):
        e = entries.get(name, {"why": "TODO: why this difference is intended.", "diff": None})
        diff = accept.get(name, e["diff"])
        body = f"## {name}\n\n{e['why']}\n"
        body += f"\n```diff\n{diff}```\n" if diff is not None else ""
        parts.append(body)
    with open(INTENDED, "w") as f:
        f.write("\n".join(parts))


# ---- main --------------------------------------------------------------------------

def main():
    global VERBOSE
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("checkout", nargs="?")
    ap.add_argument("--old", default="main")
    ap.add_argument("--rex", action="store_true")
    ap.add_argument("--only")
    ap.add_argument("--accept", action="append", default=[])
    ap.add_argument("--keep", action="store_true")
    ap.add_argument("--no-build", action="store_true")
    ap.add_argument("-v", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help or not a.checkout:
        print(__doc__.strip())
        sys.exit(0 if a.help else 2)
    VERBOSE = a.v
    checkout = os.path.realpath(a.checkout)

    def stop(sig, _):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)

    root = os.path.realpath(tempfile.mkdtemp(prefix="cbpar-", dir="/tmp"))   # short: Rex sockets live here
    CLEANUP.add("sandbox", lambda: None if a.keep else shutil.rmtree(root, ignore_errors=True))
    CLEANUP.add("leftover processes", lambda: reap(root))
    try:
        return run(a, checkout, root)
    except KeyboardInterrupt:
        say("parity: interrupted")
        return 130
    finally:
        CLEANUP.run()
        if a.keep:
            say(f"parity: kept the sandbox at {root}")


def reap(root):
    """Kill anything still running from the sandbox (its path in the command line)."""
    p = sh(["pgrep", "-f", root])
    pids = [int(x) for x in p.stdout.split() if x.isdigit() and int(x) != os.getpid()]
    if not pids:
        return
    ps = sh(["ps", "-o", "pid=,args=", "-p", ",".join(map(str, pids))]).stdout
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    say(f"parity: killed {len(pids)} process(es) still running after their server stopped:")
    for line in ps.splitlines():
        say("  " + line.strip().replace(root, "$SANDBOX")[:160])


def run(a, checkout, root):
    box = Sandbox(root, a.rex)
    old = build_old(box, a.old, a.rex)
    new = build_new(box, checkout, not a.no_build, a.rex)
    # claude-relay isn't what's compared: both sides use the new build's
    shutil.copy2(os.path.join(new.bin, "claude-relay"), os.path.join(old.bin, "claude-relay"))
    todo = [c for c in cases() if not a.only or re.search(a.only, c.name)]
    results = {}
    for side in (old, new):
        say(f"parity: {side.name} side: setting up")
        try:
            setup(side)
        except RuntimeError as e:
            say(f"parity: {side.name} side: setup failed: {e}")
            if side.rex:
                return 1
        say(f"parity: {side.name} side: {len(todo)} cases")
        for c in todo:
            if c.old is None and c.runner is None:
                continue
            argv = c.argv(side)
            if argv:
                term = "--rex" if side.rex else "--tmux"
                argv = [x.replace("{home}", box.home).replace("{term}", term) for x in argv]
                c_side = Case(c.name, argv, pane=c.pane, kind=c.kind, stdin=c.stdin, timeout=c.timeout)
            else:
                c_side = c
            if c.pane and c.pane not in side.panes_at:
                results.setdefault(c.name, {})[side.name] = (f"no {c.pane} pane", "", "")
                continue
            results.setdefault(c.name, {})[side.name] = c_side.execute(side)
        side.mux.stop()   # the next side starts from nothing
        if any(c.name == "leftovers" for c in todo):
            results.setdefault("leftovers", {})[side.name] = leftovers(side)

    intended, _ = read_intended()
    accept = {}
    rows = []
    fired_all = {}
    for c in todo:
        r = results.get(c.name, {})
        if "old" not in r or "new" not in r:
            continue
        o, _ = normalize(c, old, r["old"])
        n, fired = normalize(c, new, r["new"])
        for f in fired:
            fired_all.setdefault(f, []).append(c.name)
        d = os.path.join(box.out, c.name)
        os.makedirs(d)
        for k, v in (("old", o), ("new", n)):
            open(os.path.join(d, f"{k}.txt"), "w").write(v)
        for k in ("old", "new"):
            code, out, err = r[k]
            open(os.path.join(d, f"{k}.raw"), "w").write(f"{out}\n--- stderr\n{err}\n--- exit {code}\n")
        diff = "".join(difflib.unified_diff(o.splitlines(True), n.splitlines(True), "old", "new", n=2))
        if diff:
            open(os.path.join(d, "diff"), "w").write(diff)
        e = intended.get(c.name)
        if not diff:
            status = "pass"
        elif e and (e["diff"] is None or e["diff"] == diff):
            status = "intended"
        elif e:
            status = "CHANGED"
        else:
            status = "DIFF"
        if diff and ("all" in a.accept or c.name in a.accept):
            accept[c.name] = diff
            status = "accepted"
        rows.append((c.name, status, diff, e))

    if accept:
        write_intended(intended, accept)
    width = max((len(r[0]) for r in rows), default=10)
    counts = {}
    for name, status, diff, e in rows:
        counts[status] = counts.get(status, 0) + 1
        note = ""
        if status in ("DIFF", "CHANGED", "accepted"):
            note = f"{sum(1 for l in diff.splitlines() if l[:1] in '+-' and l[:3] not in ('---', '+++'))} lines differ"
        elif status == "intended":
            note = e["why"].splitlines()[0][:70] if e["why"] else ""
        print(f"{status:<9} {name:<{width}}  {note}")
        if diff and VERBOSE:
            print("".join("    " + l for l in diff.splitlines(True)))
    for rule, names_ in fired_all.items():
        print(f"normalized: {rule} ({len(names_)} cases)")
    stale = sorted(set(intended) - {r[0] for r in rows}) if not a.only else []
    for name in stale:
        print(f"stale     {name}  (in intended.md, but no such case ran)")
    print(" · ".join(f"{v} {k}" for k, v in sorted(counts.items())) + f"   ({'rex' if a.rex else 'tmux'})")
    shutil.rmtree(OUT, ignore_errors=True)
    shutil.copytree(box.out, OUT)
    print(f"outputs and diffs: {os.path.relpath(OUT)}/<case>/{{old,new}}.txt, diff")
    return 1 if counts.get("DIFF") or counts.get("CHANGED") else 0


if __name__ == "__main__":
    sys.exit(main())
