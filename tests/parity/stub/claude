#!/bin/sh
# Stand-in for Claude Code in the parity sandbox: it never starts a real Claude.
#
#   claude agents --json     prints [] (the switchboards ask this in tmux)
#   claude -n NAME [-w WT] [--append-system-prompt P] [--resume ID] [PROMPT]
#
# It reports its state as Claude does, with OSC 7501 (Rex reads it; in tmux,
# claude-relay turns it into pane options). The state comes from the brief the
# prompt names ("Read BRIEF and do the task it describes."): its first line
# `stub: STATE [KIND] [| MESSAGE]`. Without one it is idle. Then each line typed
# into it makes it work for $CBAR_STUB_WORK seconds (default 2) and finish
# done with "did: LINE"; a typed `/state STATE [KIND] [| MESSAGE]` sets that state.
#
# For the cbar restart tests (tests/restart/run), off unless asked for:
#   $CBAR_STUB_LOG       a folder: each start writes its argv there, NUL-separated,
#                        as NAME.PID
#   $CBAR_STUB_SESSIONS  set: it writes ~/.claude/sessions/PID.json as Claude Code
#                        does (sessionId: the --resume ID, else a new one), and
#                        removes it when it quits
#   typed /exit          quits, and like a Claude takes the rest of its process
#                        group with it (after a typed /deaf it ignores /exit);
#                        started with -w, it first asks as Claude Code does whether
#                        to keep the worktree, and quits on Enter (Keep), writing
#                        "kept" to $CBAR_STUB_LOG/NAME.PID.exit
#                        after a typed /bg (background work: a Monitor running
#                        cbar watch) it first asks whether to stop it, as Claude
#                        Code does, and goes on to quit on Enter ("Exit and stop
#                        tasks"), writing "stopped" to $CBAR_STUB_LOG/NAME.PID.bg
#   typed /sh CMD        works while sh -c CMD runs (a Claude running a tool), then done
#   ~/.claude/stub-untrusted  folders, one a line: started in one, it first asks to
#                        trust it as Claude Code does, with "No, exit" chosen, and
#                        reports no state. Any line typed there answers it: it
#                        writes the line to $CBAR_STUB_LOG/NAME.PID.trust and quits
#                        (No, exit); a typed /trust answers Yes and goes on

if [ "$1" = agents ]; then
  echo '[]'
  exit 0
fi

if [ -n "$CBAR_STUB_LOG" ]; then
  mkdir -p "$CBAR_STUB_LOG"
  printf '%s\0' "$@" > "$CBAR_STUB_LOG/.argv.$$"
fi
name= wt=- prompt= resume=
while [ $# -gt 0 ]; do
  case $1 in
    -n) name=$2; shift ;;
    -w) wt=$2; shift ;;
    --append-system-prompt) shift ;;
    --resume) resume=$2; shift ;;
    *) prompt=$1 ;;
  esac
  shift
done
[ -n "$CBAR_STUB_LOG" ] && mv "$CBAR_STUB_LOG/.argv.$$" "$CBAR_STUB_LOG/$name.$$"
brief=$(printf '%s\n' "$prompt" | sed -n 's/^Read \(.*\) and do the task it describes\.$/\1/p')

session_file=
if [ -n "$CBAR_STUB_SESSIONS" ]; then
  sid=${resume:-$(uuidgen | tr 'A-Z' 'a-z')}
  mkdir -p "$HOME/.claude/sessions"
  session_file="$HOME/.claude/sessions/$$.json"
  printf '{"pid":%s,"sessionId":"%s","cwd":"%s","kind":"interactive","status":"idle"}\n' "$$" "$sid" "$PWD" > "$session_file"
fi

# emit SPEC: report "STATE [KIND] [| MESSAGE]"
emit() {
  spec=$1 msg=
  case $spec in *' | '*) msg=${spec#* | }; spec=${spec%% | *} ;; esac
  set -- $spec
  state=$1 kind=$2
  out="state=$state:app=claude-code"
  [ -n "$kind" ] && out="$out:kind=$kind"
  [ -n "$msg" ] && out="$out:msg=$(printf '%s' "$msg" | base64 | tr -d '\n')"
  printf '\033]7501;%s\033\\' "$out"
}

quit() {
  [ -n "$session_file" ] && rm -f "$session_file"
  exit 0
}

untrusted="$HOME/.claude/stub-untrusted"
if [ -f "$untrusted" ] && grep -qxF "$PWD" "$untrusted"; then
  echo " Accessing workspace:"
  echo
  echo " $PWD"
  echo
  echo " Quick safety check: Is this a project you created or one you trust? (Like your own code, a well-known open source project, or work from your team). If not,"
  echo " take a moment to review what's in this folder first."
  echo
  echo " Claude Code'll be able to read, edit, and execute files here."
  echo
  echo " Security guide"
  echo
  echo " ❯ No, exit"
  echo "   Yes, I trust this folder"
  echo
  echo " Enter to confirm · Esc to cancel"
  IFS= read -r line
  if [ "$line" != /trust ]; then
    [ -n "$CBAR_STUB_LOG" ] && printf '%s\n' "$line" > "$CBAR_STUB_LOG/$name.$$.trust"
    quit
  fi
fi

script=
[ -n "$brief" ] && [ -f "$brief" ] && script=$(sed -n '1s/^stub: //p' "$brief")
echo "stub claude: $name"
echo "worktree: $wt"
echo "brief: ${brief##*/}"
[ -n "$resume" ] && echo "resumed: $resume"
echo "state: ${script:-idle}"
emit "${script:-idle}"

leave() {
  [ -n "$session_file" ] && rm -f "$session_file"
  trap '' TERM
  kill -TERM 0 2>/dev/null
  exit 0
}

ask_worktree() {
  asking=wt
  echo "  Exiting worktree session"
  echo "  ❯ 1. Keep worktree    Stays at $PWD/.claude/worktrees/$wt"
  echo "    2. Remove worktree  Clean up the worktree directory."
  echo "  Enter to confirm · Esc to cancel"
}

deaf= asking= bg=
trap quit HUP TERM INT
while IFS= read -r line; do
  echo "> $line"
  if [ -n "$asking" ]; then
    if [ -z "$line" ]; then
      if [ "$asking" = bg ]; then
        [ -n "$CBAR_STUB_LOG" ] && echo stopped > "$CBAR_STUB_LOG/$name.$$.bg"
        bg=
        if [ "$wt" != - ]; then ask_worktree; else leave; fi
        continue
      fi
      [ -n "$CBAR_STUB_LOG" ] && echo kept > "$CBAR_STUB_LOG/$name.$$.exit"
      leave
    fi
    continue
  fi
  case $line in
    '/state '*) emit "${line#/state }" ;;
    /exit)
      if [ -n "$deaf" ]; then
        :
      elif [ -n "$bg" ]; then
        asking=bg
        echo "  Background work is running"
        echo "  The following will stop when you exit:"
        echo "  monitor · cbar watch"
        echo "  ❯ 1. Exit and stop tasks"
        echo "    2. Move to background and exit"
        echo "    3. Stay"
        echo "  Enter to confirm · Esc to cancel"
      elif [ "$wt" != - ]; then
        ask_worktree
      else
        leave
      fi
      ;;
    /deaf) deaf=1 ;;
    /bg) bg=1 ;;
    '/sh '*)
      emit working
      sh -c "${line#/sh }"
      emit "done | ran: ${line#/sh }"
      ;;
    '') ;;
    *)
      emit working
      sleep "${CBAR_STUB_WORK:-2}"
      emit "done | did: $line"
      ;;
  esac
done
quit
