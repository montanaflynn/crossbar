#!/usr/bin/env python3
"""Test `cbar watch`'s stopped in a sandbox: a private tmux server, or a
private Rex server, never the live one (the parity harness's sandbox,
tests/parity/run).

  tests/watch/run [--rex] [--keep] [--no-build] [-v] CHECKOUT

The supervisor's watch hears the operators of alpha and beta, idle (stub
Claudes, tests/parity/stub/claude). In Rex, its `rex block call`s then fail
for a few looks, as the live ones did when the Rex server was slow (they
timed out at cbar's 5s): 0.5.2 printed "<project> operator: stopped" for
Claudes that were still there. Nothing may be printed for that. Then beta's
Claude really quits (/exit): "beta operator: stopped" must come within a
look or two, and the pane, once closed, "closed".

Before that, `cbar watch --next` in alpha's operator pane, run after run:
the first exits at once on what stands; one with nothing new waits, silently,
until an agent turns done, and through a turn that ends on the line printed
last for its pane; what happens while none runs (a done, a block, a Claude
that quits, a closed tab) is printed by the next run, and nothing by the one
after. Prints one line per check; exits 1 if any fails.
"""
import argparse
import importlib.machinery
import importlib.util
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
_loader = importlib.machinery.SourceFileLoader("parity", os.path.join(HERE, "..", "parity", "run"))
_spec = importlib.util.spec_from_loader("parity", _loader)
P = importlib.util.module_from_spec(_spec)
_loader.exec_module(P)

FAILS = []
VERBOSE = False


def check(name, ok, detail=""):
    print(f"{'ok  ' if ok else 'FAIL'}  {name}" + (f"  ({detail})" if detail and (not ok or VERBOSE) else ""), flush=True)
    if not ok:
        FAILS.append(name)
    return ok


def wait_for(fn, limit=60, step=0.5):
    end = time.time() + limit
    while time.time() < end:
        v = fn()
        if v:
            return v
        time.sleep(step)
    return fn()


def flaky_rex(side):
    """A folder whose `rex` fails every `rex block call` while the file it
    returns exists (a second late, as a slow server's call does), and is the
    sandbox's rex otherwise."""
    d = os.path.join(side.box.root, "flaky")
    os.makedirs(d)
    flag = os.path.join(side.box.root, "rex-fails")
    with open(os.path.join(d, "rex"), "w") as f:
        f.write(f'#!/bin/sh\nif [ -e "{flag}" ] && [ "$1 $2" = "block call" ]; then sleep 1; echo "rex: timed out" >&2; exit 1; fi\n'
                f'exec "{os.path.join(side.stub, "rex")}" "$@"\n')
    os.chmod(os.path.join(d, "rex"), 0o755)
    return d, flag


def agent_pane(side, tab):
    return next(((x["sid"], x["pane"]) for x in side.mux.panes() if x["session"] == side.session("alpha") and x["tab"] == tab), None)


def next_cases(side):
    """`cbar watch --next` in alpha's operator pane, run after run, over
    alpha's agents (t-done done, t-ask blocked, t-boom error, t-busy
    working, t-chat idle)."""
    env = dict(side.env)
    env.update(side.mux.pane_env(*side.panes_at["alpha"]))
    runs = [0]

    def start():
        runs[0] += 1
        log = os.path.join(side.box.root, f"next-{runs[0]}.out")
        out, err = open(log, "w"), open(log + ".err", "w")
        p = subprocess.Popen([os.path.join(side.bin, "cbar"), "watch", "--next"], env=env, cwd=side.box.home,
                             stdout=out, stderr=err, stdin=subprocess.DEVNULL, start_new_session=True)
        P.CLEANUP.add(f"watch --next {runs[0]}", lambda: p.poll() is None and os.killpg(p.pid, signal.SIGKILL))
        return p, log

    def lines(log):
        return sorted(x for x in open(log).read().splitlines() if x.strip())

    def exited(p, limit):
        try:
            return p.wait(limit) == 0
        except subprocess.TimeoutExpired:
            return False

    def stop(p):
        if p.poll() is None:
            os.killpg(p.pid, signal.SIGTERM)
            p.wait(10)

    # 1: what stands at startup is news to the first watch: it prints it and exits at once
    p, log = start()
    t0 = time.time()
    check("--next with news at startup exits 0", exited(p, 20), open(log).read().strip())
    check("promptly (within 8s)", time.time() - t0 <= 8, f"{time.time() - t0:.1f}s")
    want = ["t-ask: blocked (permission) — allow npm test?", "t-boom: error — tests failed", "t-done: done — finished the thing"]
    check("it printed what stands", lines(log) == want, lines(log))
    stop(p)

    # 2: nothing new: it waits, silently, until t-chat is sent a line and turns done
    p, log = start()
    time.sleep(12)
    check("idle, --next keeps waiting", p.poll() is None, f"exit {p.poll()}")
    check("and prints nothing (what stands was printed)", lines(log) == [], lines(log))
    chat = agent_pane(side, "t-chat")
    side.mux.send_line(*chat, "ping")
    check("an event exits it", exited(p, 20), open(log).read().strip())
    check("it printed the event", lines(log) == ["t-chat: done — did: ping"], lines(log))
    stop(p)

    # 2b: t-chat's next turn ends on the same line: no news, so it waits; a new line is news
    p, log = start()
    side.mux.send_line(*chat, "ping")
    time.sleep(12)   # working, and done again with the same message
    check("a turn ending as the last one did doesn't exit --next", p.poll() is None, f"exit {p.poll()}: {open(log).read().strip()}")
    check("and isn't printed again", lines(log) == [], lines(log))
    side.mux.send_line(*chat, "pong")
    check("a new message exits it", exited(p, 20), open(log).read().strip())
    check("it printed the new line only", lines(log) == ["t-chat: done — did: pong"], lines(log))
    stop(p)

    # 3: while no watch runs: t-busy turns done, t-chat blocked, t-boom's Claude quits, t-done closes
    side.mux.send_line(*agent_pane(side, "t-busy"), "/state done | busy no more")
    side.mux.send_line(*chat, "/state blocked permission | allow rm?")
    boom = agent_pane(side, "t-boom")
    side.mux.send_line(*boom, "/exit")
    time.sleep(1)
    side.mux.send_line(*boom, "")   # Enter: keep its worktree
    gone = side.run(["cbar", "rm", "t-done"], pane="alpha")
    check("t-done closed", gone[0] == 0, gone)
    # (Rex keeps a quit Claude's last status on its pane: its process is what's gone)
    boom_runs = lambda: P.sh(["pgrep", "-f", f"{side.stub}/claude -n t-boom"]).stdout.strip() != ""
    states = lambda: {x["tab"]: x["state"] for x in side.mux.panes() if x["session"] == side.session("alpha")}
    settled = wait_for(lambda: (lambda s: s.get("t-busy") == "done" and s.get("t-chat") == "blocked" and "t-done" not in s)(states()) and not boom_runs(), limit=30)
    check("the changes took", settled, f"{states()}, t-boom's Claude {'runs' if boom_runs() else 'quit'}")
    p, log = start()
    check("the next --next exits on them", exited(p, 30), open(log).read().strip())
    want = ["t-boom: stopped", "t-busy: done — busy no more", "t-chat: blocked (permission) — allow rm?", "t-done: closed — finished the thing"]
    check("it printed each event between the runs", lines(log) == want, lines(log))
    stop(p)

    # 4: and the run after that has nothing to say: none twice
    p, log = start()
    time.sleep(12)
    check("the run after waits", p.poll() is None, f"exit {p.poll()}")
    check("and repeats nothing", lines(log) == [], lines(log))
    stop(p)
    errs = "".join(open(os.path.join(side.box.root, f"next-{i}.out.err")).read() for i in range(1, runs[0] + 1))
    check("--next wrote no errors", errs.strip() == "", errs.strip())


def cases(side):
    E = P.EXCHANGE
    env = dict(side.env)
    env.update(side.mux.pane_env(*side.panes_at[E]))
    flag = None
    if side.rex:
        d, flag = flaky_rex(side)
        env["PATH"] = f"{d}:{env['PATH']}"
    log = os.path.join(side.box.root, "watch.out")
    with open(log, "w") as out, open(log + ".err", "w") as err:
        p = subprocess.Popen([os.path.join(side.bin, "cbar"), "watch"], env=env, cwd=side.box.home,
                             stdout=out, stderr=err, stdin=subprocess.DEVNULL, start_new_session=True)
    P.CLEANUP.add("watch", lambda: p.poll() is None and os.killpg(p.pid, signal.SIGKILL))
    text = lambda: open(log).read()
    time.sleep(8)   # its startup report, and a look or two
    start = len(text())
    if flag:
        open(flag, "w").close()
        time.sleep(10)   # a few looks whose reads all fail
        os.remove(flag)
    time.sleep(8)
    blip = text()[start:]
    check("idle operators whose reads fail aren't stopped" if flag else "idle operators aren't stopped",
          "stopped" not in blip, blip.strip())
    check("nor reported again once read", blip.strip() == "", blip.strip())

    # beta's Claude quits: a real stop, reported within a look or two
    sid, pane = side.panes_at["beta"]
    mark = len(text())
    side.mux.send_line(sid, pane, "/exit")
    t0 = time.time()
    got = wait_for(lambda: "beta operator: stopped" in text()[mark:], limit=20)
    check("a Claude that quits is stopped", got, text()[mark:].strip())
    if got:
        check("promptly (within 8s)", time.time() - t0 <= 8, f"{time.time() - t0:.1f}s")
    check("alpha's operator isn't", "alpha operator" not in text()[mark:], text()[mark:].strip())

    # alpha's pane closes: closed
    asid, apane = side.panes_at["alpha"]
    mark = len(text())
    if side.rex:
        side.mux("block", "close", "-s", asid, apane)
    else:
        side.mux("kill-pane", "-t", apane)
    got = wait_for(lambda: "alpha operator: closed" in text()[mark:], limit=20)
    check("a closed pane is closed", got, text()[mark:].strip())

    os.killpg(p.pid, signal.SIGTERM)
    p.wait(10)
    err = open(log + ".err").read()
    check("watch wrote no errors", err.strip() == "", err.strip())
    if VERBOSE:
        P.say("watch printed:\n" + text())


def main():
    global VERBOSE
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("checkout", nargs="?")
    ap.add_argument("--rex", action="store_true")
    ap.add_argument("--keep", action="store_true")
    ap.add_argument("--no-build", action="store_true")
    ap.add_argument("-v", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help or not a.checkout:
        print(__doc__.strip())
        sys.exit(0 if a.help else 2)
    VERBOSE = a.v

    def stop(sig, _):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    root = os.path.realpath(tempfile.mkdtemp(prefix="cbwat-", dir="/tmp"))   # short: Rex sockets live here
    C = P.CLEANUP
    C.add("sandbox", lambda: None if a.keep else shutil.rmtree(root, ignore_errors=True))
    C.add("leftover processes", lambda: P.reap(root))
    try:
        box = P.Sandbox(root, a.rex)
        side = P.build_new(box, os.path.realpath(a.checkout), not a.no_build, a.rex)
        P.say(f"watch: setting up ({'rex' if a.rex else 'tmux'})")
        P.setup(side)
        next_cases(side)
        cases(side)
        side.mux.stop()
        n, ps, _ = P.leftovers(side)
        check("nothing left running", n == 0, ps)
    except KeyboardInterrupt:
        P.say("watch: interrupted")
        return 130
    finally:
        C.run()
        if a.keep:
            P.say(f"watch: kept the sandbox at {root}")
    print(f"{len(FAILS)} failed ({'rex' if a.rex else 'tmux'})" if FAILS else f"all passed ({'rex' if a.rex else 'tmux'})")
    return 1 if FAILS else 0


if __name__ == "__main__":
    sys.exit(main())
